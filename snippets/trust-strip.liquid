{% comment %}
  Reusable trust strip — SSL / returns / shipping / customer count.
  Accepts: variant: 'full' | 'compact' (default 'full').

  Renders only when `settings.trust_strip_enabled` is true OR `variant` is
  forced via the parent context (cart drawer renders compact).
{% endcomment %}

{%- assign variant = variant | default: 'full' -%}
{%- assign show = settings.trust_strip_enabled -%}
{%- if variant == 'compact' -%}{%- assign show = true -%}{%- endif -%}

{%- if show -%}
  <ul class="trust-strip trust-strip--{{ variant }}" role="list" aria-label="{{ 'sections.trust_strip.label' | t }}">
    <li class="trust-strip__item">
      <span class="trust-strip__icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="3" y="11" width="18" height="11" rx="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </span>
      <div class="trust-strip__copy">
        <strong>{{ settings.trust_ssl_title | default: 'Secure checkout' }}</strong>
        <span>{{ settings.trust_ssl_sub | default: 'SSL encryption — Powered by Shopify' }}</span>
      </div>
    </li>

    <li class="trust-strip__item">
      <span class="trust-strip__icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M3 12a9 9 0 1 0 3-6.7"/>
          <path d="M3 5v5h5"/>
        </svg>
      </span>
      <div class="trust-strip__copy">
        <strong>{{ settings.trust_return_title | default: '30-day returns' }}</strong>
        <span>{{ settings.trust_return_sub | default: 'Free returns on every order' }}</span>
      </div>
    </li>

    <li class="trust-strip__item">
      <span class="trust-strip__icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="1" y="7" width="14" height="10"/>
          <path d="M15 11h4l3 3v3h-7zM6 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM18 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/>
        </svg>
      </span>
      <div class="trust-strip__copy">
        <strong>{{ settings.trust_shipping_title | default: 'Free shipping' }}</strong>
        <span>
          {%- if settings.trust_free_shipping_threshold > 0 -%}
            {{ settings.trust_shipping_sub_threshold | default: 'On orders over' }} {{ settings.trust_free_shipping_threshold | money }}
          {%- else -%}
            {{ settings.trust_shipping_sub_any | default: 'On every order' }}
          {%- endif -%}
        </span>
      </div>
    </li>

    {%- if settings.trust_show_customer_count -%}
      <li class="trust-strip__item">
        <span class="trust-strip__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </span>
        <div class="trust-strip__copy">
          <strong>{{ settings.trust_customer_count | default: '12,847' }}+</strong>
          <span>{{ settings.trust_customer_count_label | default: 'happy customers' }}</span>
        </div>
      </li>
    {%- endif -%}
  </ul>
{%- endif -%}
