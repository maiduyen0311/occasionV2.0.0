{%- comment -%}
  Five outline stars (PSD: 17×15 star shapes on a 13px pitch, grey #919191; rated stars gold).
  Rating from the standard reviews.rating metafield; no rating → five empty stars.
  Accepts:
  - product {Object}
  - class {String} extra class (optional)
{%- endcomment -%}
{%- liquid
  assign rating = 0
  assign rating_max = 5
  if product.metafields.reviews.rating.value != blank
    assign rating = product.metafields.reviews.rating.value.rating | round
    assign rating_max = product.metafields.reviews.rating.value.scale_max | default: 5
  endif
-%}
<div
  class="oc-stars {{ class }}"
  role="img"
  aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating, rating_max: rating_max }}"
>
  {%- for i in (1..5) -%}
    <span class="oc-stars__star{% if i <= rating %} is-on{% endif %}" aria-hidden="true">
      {%- render 'oc-icon', name: 'star' -%}
    </span>
  {%- endfor -%}
</div>
