{%- comment -%}
  Global quick-view modal. Renders once near the end of <body> so any
  card-product on the page can target it. JS module quick-view.js
  fetches the product page HTML on click, extracts the product form +
  media, and injects into `#QuickViewBody`.

  No section settings — the entire UX is theme-fixed.
{%- endcomment -%}

<div
  id="QuickViewModal"
  class="quick-view-modal"
  hidden
  aria-hidden="true"
  data-quick-view-modal
>
  <div class="quick-view-modal__backdrop" data-quick-view-close></div>
  <div
    class="quick-view-modal__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="QuickViewTitle"
    tabindex="-1"
  >
    <button
      type="button"
      class="quick-view-modal__close"
      aria-label="{{ 'accessibility.close' | t | default: 'Close' }}"
      data-quick-view-close
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M6 18L18 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>

    <div id="QuickViewBody" class="quick-view-modal__body" data-quick-view-body>
      <div class="quick-view-modal__loading">
        <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
          <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
        </svg>
      </div>
    </div>
  </div>
</div>
