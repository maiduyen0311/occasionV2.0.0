{%- comment -%}
  Occasion SVG icon library (24×24 stroke, currentColor).
  Usage: {% render 'svg', name: 'truck' %}  — or {% render 'tm-icon', icon: 'truck', source: 'library' %}
  Valid ids: scripts/data/svg-icons.json

  Icons: truck package map-pin gift tag cart heart user search menu close check
  chevron-down chevron-down-sm chevron-down-xs chevron-up chevron-left chevron-right arrow-right arrow-left mail phone
  menu menu-bold menu-lines close close-bold gift-promo
  clock calendar star home settings bell shield lock unlock eye pencil trash plus minus
  info alert-circle help-circle refresh-cw download upload share-2 link external-link
  filter grid list image camera credit-card percent ticket award zap globe message-circle
  headset store bookmark copy clipboard
{%- endcomment -%}

{%- liquid
  assign icon_name = name | default: ''
  assign svg_class = class | default: ''
-%}

