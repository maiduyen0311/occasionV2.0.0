{%- comment -%}
  Occasion section heading — 20px uppercase title over a 1px #efefef rule with a darker
  60px centre mark (design/SPEC.md §3.2). Optional Prev / Next buttons on the right
  (left-aligned variant), wired by the caller via data attributes.
  Accepts:
  - title {String} heading text (inline richtext allowed)
  - align {String} 'center' (default) | 'left'
  - tag {String} heading tag, default h2
  - nav {Boolean} show "Prev / Next" buttons
  - nav_target {String} value for data-oc-nav (id of the element the buttons control)
  - size {Number} title size in px (default 20)
  - accent {String} colour of the 58px centre mark (blank: theme secondary)
  - rule {Boolean} false hides the grey line under the title
{%- endcomment -%}
{%- liquid
  assign align = align | default: 'center'
  assign tag = tag | default: 'h2'
-%}
{%- if title != blank or nav -%}
  <div
    class="oc-heading oc-heading--{{ align }}{% if nav %} oc-heading--nav{% endif %}{% if rule == false %} oc-heading--no-rule{% endif %}"
    {%- if size or accent != blank %} style="{% if size %}--oc-heading-size: {{ size }}px;{% endif %}{% if accent != blank %}--oc-heading-accent: {{ accent }};{% endif %}"{% endif %}
  >
    {%- if title != blank -%}
      <{{ tag }} class="oc-heading__title">{{ title }}</{{ tag }}>
    {%- endif -%}
    {%- if nav -%}
      <div class="oc-heading__nav" data-oc-nav="{{ nav_target }}">
        <button type="button" class="oc-heading__nav-btn" data-oc-prev aria-label="{{ 'general.slider.previous_slide' | t }}">{{ 'sections.occasion.prev' | t }}</button>
        <span class="oc-heading__nav-sep" aria-hidden="true">/</span>
        <button type="button" class="oc-heading__nav-btn" data-oc-next aria-label="{{ 'general.slider.next_slide' | t }}">{{ 'sections.occasion.next' | t }}</button>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
