{%- comment -%}
  Address form fields (Bootstrap row) shared by the "add" and "edit" forms in
  sections/main-addresses.liquid. IDs follow Dawn's customer.js contract:
  AddressCountry{suffix} / AddressProvince{suffix} / AddressProvinceContainer{suffix}.

  Accepts:
    - form: {object} The customer_address form object
    - suffix: {string} 'New' or '_<address.id>'
    - is_new: {boolean}
{%- endcomment -%}
<div class="row g-3">
  <div class="col-12 col-md-6">
    <label class="tm-label" for="AddressFirstName{{ suffix }}">{{ 'customer.addresses.first_name' | t }}</label>
    <input class="tm-input" type="text" id="AddressFirstName{{ suffix }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
  </div>
  <div class="col-12 col-md-6">
    <label class="tm-label" for="AddressLastName{{ suffix }}">{{ 'customer.addresses.last_name' | t }}</label>
    <input class="tm-input" type="text" id="AddressLastName{{ suffix }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
  </div>
  <div class="col-12">
    <label class="tm-label" for="AddressCompany{{ suffix }}">{{ 'customer.addresses.company' | t }}</label>
    <input class="tm-input" type="text" id="AddressCompany{{ suffix }}" name="address[company]" value="{{ form.company }}" autocomplete="organization">
  </div>
  <div class="col-12 col-md-6">
    <label class="tm-label" for="AddressAddress1{{ suffix }}">{{ 'customer.addresses.address1' | t }}</label>
    <input class="tm-input" type="text" id="AddressAddress1{{ suffix }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1">
  </div>
  <div class="col-12 col-md-6">
    <label class="tm-label" for="AddressAddress2{{ suffix }}">{{ 'customer.addresses.address2' | t }}</label>
    <input class="tm-input" type="text" id="AddressAddress2{{ suffix }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
  </div>
  <div class="col-12 col-md-6">
    <label class="tm-label" for="AddressCity{{ suffix }}">{{ 'customer.addresses.city' | t }}</label>
    <input class="tm-input" type="text" id="AddressCity{{ suffix }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2">
  </div>
  <div class="col-12 col-md-6">
    <label class="tm-label" for="AddressCountry{{ suffix }}">{{ 'customer.addresses.country' | t }}</label>
    <div class="tm-select">
      <select
        class="tm-input"
        id="AddressCountry{{ suffix }}"
        name="address[country]"
        data-default="{{ form.country }}"
        autocomplete="country"
        {% unless is_new %}data-address-country-select data-form-id="{{ form.id }}"{% endunless %}
      >
        {{ all_country_option_tags }}
      </select>
    </div>
  </div>
  <div class="col-12 col-md-6" id="AddressProvinceContainer{{ suffix }}" style="display: none">
    <label class="tm-label" for="AddressProvince{{ suffix }}">{{ 'customer.addresses.province' | t }}</label>
    <div class="tm-select">
      <select class="tm-input" id="AddressProvince{{ suffix }}" name="address[province]" data-default="{{ form.province }}" autocomplete="address-level1"></select>
    </div>
  </div>
  <div class="col-12 col-md-6">
    <label class="tm-label" for="AddressZip{{ suffix }}">{{ 'customer.addresses.zip' | t }}</label>
    <input class="tm-input" type="text" id="AddressZip{{ suffix }}" name="address[zip]" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code">
  </div>
  <div class="col-12 col-md-6">
    <label class="tm-label" for="AddressPhone{{ suffix }}">{{ 'customer.addresses.phone' | t }}</label>
    <input class="tm-input" type="tel" id="AddressPhone{{ suffix }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
  </div>
  <div class="col-12">
    <label class="tm-check">
      {{ form.set_as_default_checkbox }}
      <span>{{ 'customer.addresses.set_default' | t }}</span>
    </label>
  </div>
  <div class="col-12 d-flex flex-wrap gap-3 mt-3">
    <button class="tm-btn">{% if is_new %}{{ 'customer.addresses.add' | t }}{% else %}{{ 'customer.addresses.update' | t }}{% endif %}</button>
    <button type="reset" class="tm-btn tm-btn--outline">{{ 'customer.addresses.cancel' | t }}</button>
  </div>
</div>
