{%- comment -%}
  Mini cart drawer — design/Mini-Cart.jpg.
  Rendered by layout/theme.liquid (cart_type = drawer) and by sections/cart-drawer.liquid
  (Section Rendering API source used after add-to-cart / quantity changes).

  Dawn JS contract kept (assets/cart-drawer.js + assets/cart.js):
    <cart-drawer> > #CartDrawer > #CartDrawer-Overlay + .drawer__inner (re-rendered)
    <cart-drawer-items> #CartDrawer-CartItems, rows #CartDrawer-Item-N (.cart-item),
    <quantity-input> .quantity__input#Drawer-quantity-N[data-index], <cart-remove-button data-index>,
    #CartDrawer-LineItemError-N .cart-item__error-text, #CartDrawer-LiveRegionText,
    #CartDrawer-LineItemStatus, #CartDrawer-CartErrors, .cart-drawer__footer, .drawer__inner-empty
  Extra tools (note / shipping / coupon panels, gift wrap, coupon checkout):
    common/js/modules/mini-cart.js. Styles: common/scss/section/_cart-drawer.scss.
{%- endcomment -%}
{%- unless template.name == 'cart' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}
<script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>

<cart-drawer class="drawer mini-cart mini-cart--{{ settings.mini_cart_style | default: 'compact' }}{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner mini-cart__inner{% if cart == empty %} is-empty{% endif %}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ settings.mini_cart_heading | default: 'Shopping Cart' | escape }}"
      tabindex="-1"
    >
      <div class="mini-cart__header">
        <h2 class="mini-cart__heading">
          {{ settings.mini_cart_heading | default: 'Shopping Cart' }}
          <span class="mini-cart__count">({{ cart.item_count }})</span>
        </h2>
        <button class="drawer__close mini-cart__close" type="button" onclick="this.closest('cart-drawer').close()" aria-label="{{ 'accessibility.close' | t }}">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13"/></svg>
        </button>
      </div>

      {%- if cart == empty -%}
        <div class="drawer__inner-empty mini-cart__empty">
          <svg viewBox="0 0 64 64" width="64" height="64" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 12h8l6 30h28l6-22H20"/><circle cx="26" cy="51" r="3"/><circle cx="46" cy="51" r="3"/></svg>
          <p class="mini-cart__empty-text">{{ settings.mini_cart_empty_text | default: 'Your cart is currently empty.' }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="mini-cart__btn mini-cart__btn--accent">{{ 'general.continue_shopping' | t }}</a>
          {%- if shop.customer_accounts_enabled and customer == null -%}
            <p class="mini-cart__login">{{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}</p>
          {%- endif -%}
        </div>
      {%- else -%}
        <cart-drawer-items class="mini-cart__items">
          <form action="{{ routes.cart_url }}" id="CartDrawer-Form" class="cart__contents" method="post">
            <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
              <ul class="mini-cart__list list-unstyled" role="list" aria-label="{{ 'sections.cart.title' | t }}">
                {%- for item in cart.items -%}
                  {%- liquid
                    assign line = item.index | plus: 1
                    assign unit_compare = item.variant.compare_at_price
                    if item.original_price > item.final_price
                      assign unit_compare = item.original_price
                    endif
                  -%}
                  <li id="CartDrawer-Item-{{ line }}" class="cart-item mini-cart__item">
                    <a href="{{ item.url }}" class="mini-cart__thumb" tabindex="-1" aria-hidden="true">
                      {%- if item.image -%}
                        <img src="{{ item.image | image_url: width: 180 }}" alt="" loading="lazy" width="90" height="{{ 90 | divided_by: item.image.aspect_ratio | ceil }}">
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag }}
                      {%- endif -%}
                    </a>

                    <div class="mini-cart__info">
                      <a href="{{ item.url }}" class="mini-cart__name">{{ item.product.title | escape }}</a>
                      <p class="mini-cart__price">
                        <span class="mini-cart__qty-text">{{ item.quantity }} x </span>
                        <span{% if unit_compare > item.final_price %} class="is-sale"{% endif %}>{{ item.final_price | money }}</span>
                        {%- if unit_compare > item.final_price -%}
                          <s>{{ unit_compare | money }}</s>
                        {%- endif -%}
                      </p>
                      {%- unless item.product.has_only_default_variant -%}
                        <p class="mini-cart__variant">
                          {{ item.variant.title | escape }}
                          <a href="{{ item.url }}" class="mini-cart__edit" aria-label="{{ 'sections.cart_page.edit' | t }}">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                          </a>
                        </p>
                      {%- endunless -%}
                      {% render 'cart-line-meta', item: item, class: 'mini-cart__variant' %}
                      {%- for discount in item.line_level_discount_allocations -%}
                        <p class="mini-cart__discount">{{ discount.discount_application.title | escape }} (-{{ discount.amount | money }})</p>
                      {%- endfor -%}

                      <quantity-input class="quantity mini-cart__qty">
                        <button class="quantity__button" name="minus" type="button" aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title }}">
                          <svg viewBox="0 0 10 2" width="10" height="2" aria-hidden="true"><path d="M0 1h10" stroke="currentColor" stroke-width="1.6"/></svg>
                        </button>
                        <input
                          class="quantity__input"
                          type="number"
                          name="updates[]"
                          value="{{ item.quantity }}"
                          {% # theme-check-disable %}
                          data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                          min="0"
                          data-min="{{ item.variant.quantity_rule.min }}"
                          {% if item.variant.quantity_rule.max != null %}max="{{ item.variant.quantity_rule.max }}"{% endif %}
                          step="{{ item.variant.quantity_rule.increment }}"
                          {% # theme-check-enable %}
                          aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title }}"
                          id="Drawer-quantity-{{ line }}"
                          data-index="{{ line }}"
                          data-quantity-variant-id="{{ item.variant.id }}"
                        >
                        <button class="quantity__button" name="plus" type="button" aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title }}">
                          <svg viewBox="0 0 10 10" width="10" height="10" aria-hidden="true"><path d="M0 5h10M5 0v10" stroke="currentColor" stroke-width="1.6"/></svg>
                        </button>
                      </quantity-input>
                      <div id="CartDrawer-LineItemError-{{ line }}" class="cart-item__error mini-cart__error" role="alert">
                        <small class="cart-item__error-text"></small>
                      </div>
                    </div>

                    <cart-remove-button id="CartDrawer-Remove-{{ line }}" data-index="{{ line }}" class="mini-cart__remove">
                      <button type="button" aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}">
                        <svg class="mini-cart__remove-x" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13"/></svg>
                        {%- render 'oc-icon', name: 'trash', class: 'mini-cart__remove-trash' -%}
                      </button>
                    </cart-remove-button>
                    {%- render 'loading-spinner' -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
            <div id="CartDrawer-CartErrors" class="mini-cart__errors" role="alert"></div>
          </form>
        </cart-drawer-items>

        <div class="cart-drawer__footer mini-cart__footer">
          {%- comment -%} Tools: note / shipping estimate / coupon (panels below) {%- endcomment -%}
          {%- liquid
            assign show_note = settings.mini_cart_show_note
            assign show_ship = settings.mini_cart_show_shipping
            assign show_coupon = settings.mini_cart_show_coupon
          -%}
          {%- if show_note or show_ship or show_coupon -%}
            <div class="mini-cart__tools" role="group" aria-label="{{ settings.mini_cart_heading | escape }}">
              {%- if show_note -%}
                <button type="button" class="mini-cart__tool{% if cart.note != blank %} has-value{% endif %}" data-mini-panel-open="note" aria-label="{{ 'sections.cart_page.note' | t }}" title="{{ 'sections.cart_page.note' | t }}">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3h6v1M9 10h6M9 14h6"/></svg>
                </button>
              {%- endif -%}
              {%- if show_ship -%}
                <button type="button" class="mini-cart__tool" data-mini-panel-open="shipping" aria-label="{{ 'sections.cart_page.estimate' | t }}" title="{{ 'sections.cart_page.estimate' | t }}">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 6h12v10H2zM14 9h4l3 3v4h-7z"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/><path d="M0 9h4M0 12h3"/></svg>
                </button>
              {%- endif -%}
              {%- if show_coupon -%}
                <button type="button" class="mini-cart__tool" data-mini-panel-open="coupon" aria-label="{{ 'sections.cart_page.coupon' | t }}" title="{{ 'sections.cart_page.coupon' | t }}">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 2l2.4 2.1 3.2-.3.8 3.1 2.8 1.6-1.2 3 1.2 3-2.8 1.6-.8 3.1-3.2-.3L12 22l-2.4-2.1-3.2.3-.8-3.1L2.8 15.5l1.2-3-1.2-3 2.8-1.6.8-3.1 3.2.3z"/><path d="M9 15l6-6"/><circle cx="9.5" cy="9.5" r=".8" fill="currentColor"/><circle cx="14.5" cy="14.5" r=".8" fill="currentColor"/></svg>
                </button>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- assign gift = settings.mini_cart_gift_wrap -%}
          {%- if gift != blank and gift.available -%}
            {%- liquid
              assign gift_in_cart = false
              for item in cart.items
                if item.product_id == gift.id
                  assign gift_in_cart = true
                endif
              endfor
              assign gift_price = gift.price | money
            -%}
            <p class="mini-cart__gift">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M20 7h-2.2A3 3 0 0 0 12 3.8 3 3 0 0 0 6.2 7H4a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1v8a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-8a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1Zm-5-2a1 1 0 1 1 0 2h-2V6a1 1 0 0 1 1-1Zm-6 0a1 1 0 0 1 1 1v1H8a1 1 0 0 1 0-2Zm2 15H6v-8h5Zm0-9H5V9h6Zm7 9h-5v-8h5Zm1-9h-6V9h6Z"/></svg>
              <span>{{ 'sections.cart_page.gift_wrap_html' | t: price: gift_price }}</span>
              {%- if gift_in_cart -%}
                <span class="mini-cart__gift-added">{{ 'sections.cart_page.gift_wrap_added' | t }}</span>
              {%- else -%}
                <button type="button" class="mini-cart__gift-add" data-mini-gift="{{ gift.selected_or_first_available_variant.id }}">{{ 'sections.cart_page.gift_wrap_add' | t }}</button>
              {%- endif -%}
            </p>
          {%- endif -%}

          <p class="mini-cart__coupon-chip" data-mini-coupon-chip hidden>
            <span>{{ 'sections.cart_page.coupon' | t }}: <strong data-mini-coupon-code></strong></span>
            <button type="button" data-mini-coupon-remove aria-label="{{ 'sections.cart_page.remove' | t }}">×</button>
          </p>

          <div class="mini-cart__totals">
            {%- for discount in cart.cart_level_discount_applications -%}
              <p class="mini-cart__row mini-cart__row--discount">
                <span>{{ discount.title | escape }}</span>
                <span>-{{ discount.total_allocated_amount | money }}</span>
              </p>
            {%- endfor -%}
            <p class="mini-cart__row mini-cart__row--subtotal">
              <span class="mini-cart__subtotal-label">{{ 'sections.cart_page.subtotal' | t }}</span>
              <span class="mini-cart__total-label">{{ 'sections.mini_cart.total' | t }}</span>
              <strong>{{ cart.total_price | money_with_currency }}</strong>
            </p>
            <p class="mini-cart__tax">
              {%- if cart.taxes_included -%}
                {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{ 'sections.cart_page.tax_note' | t }}
              {%- endif -%}
            </p>
          </div>

          <div class="mini-cart__actions">
            <button type="submit" id="CartDrawer-Checkout" class="mini-cart__btn mini-cart__btn--accent" name="checkout" form="CartDrawer-Form" data-mini-checkout>
              {{ 'sections.cart.checkout' | t }}
            </button>
            <a href="{{ routes.cart_url }}" class="mini-cart__btn mini-cart__btn--dark">{{ 'general.cart.view_empty_cart' | t }}</a>
            <a href="{{ routes.cart_url }}" class="mini-cart__btn mini-cart__btn--go">{{ 'sections.mini_cart.go_to_cart' | t }}</a>
          </div>

          {%- comment -%} Slide-up panels (design: white sheet over the drawer bottom) {%- endcomment -%}
          {%- if show_note -%}
            <div class="mini-cart__panel" data-mini-panel="note" hidden>
              <p class="mini-cart__panel-title">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M3 17.3V21h3.7L17.8 9.9l-3.7-3.7zM20.7 7a1 1 0 0 0 0-1.4l-2.3-2.3a1 1 0 0 0-1.4 0l-1.8 1.8 3.7 3.7z"/></svg>
                {{ 'sections.cart_page.note' | t }}
              </p>
              <label class="visually-hidden" for="CartDrawer-Note">{{ 'sections.cart_page.note' | t }}</label>
              <textarea id="CartDrawer-Note" class="mini-cart__input mini-cart__textarea" rows="3" data-mini-note>{{ cart.note }}</textarea>
              <div class="mini-cart__panel-actions">
                <button type="button" class="mini-cart__btn mini-cart__btn--outline" data-mini-panel-close>{{ 'customer.addresses.cancel' | t }}</button>
                <button type="button" class="mini-cart__btn mini-cart__btn--dark" data-mini-note-save>{{ 'sections.mini_cart.save' | t }}</button>
              </div>
            </div>
          {%- endif -%}

          {%- if show_ship -%}
            <div class="mini-cart__panel" data-mini-panel="shipping" hidden>
              <p class="mini-cart__panel-title">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 6h12v10H2zM14 9h4l3 3v4h-7z"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
                {{ 'sections.cart_page.estimate' | t }}
              </p>
              <div class="mini-cart__fields">
                <label class="visually-hidden" for="CartDrawer-Country">{{ 'sections.cart_page.country' | t }}</label>
                <select id="CartDrawer-Country" class="mini-cart__input" data-mini-country data-default="{{ localization.country.name }}">
                  {{ all_country_option_tags }}
                </select>
                <label class="visually-hidden" for="CartDrawer-Province">{{ 'sections.cart_page.province' | t }}</label>
                <select id="CartDrawer-Province" class="mini-cart__input" data-mini-province></select>
                <label class="visually-hidden" for="CartDrawer-Zip">{{ 'sections.cart_page.zip' | t }}</label>
                <input id="CartDrawer-Zip" type="text" class="mini-cart__input" placeholder="{{ 'sections.cart_page.zip' | t }}" autocomplete="postal-code" data-mini-zip>
              </div>
              <div class="mini-cart__rates" data-mini-rates role="status" aria-live="polite"></div>
              <div class="mini-cart__panel-actions">
                <button type="button" class="mini-cart__btn mini-cart__btn--outline" data-mini-panel-close>{{ 'customer.addresses.cancel' | t }}</button>
                <button type="button" class="mini-cart__btn mini-cart__btn--dark" data-mini-estimate>{{ 'sections.mini_cart.calculate' | t }}</button>
              </div>
            </div>
          {%- endif -%}

          {%- if show_coupon -%}
            <div class="mini-cart__panel" data-mini-panel="coupon" hidden>
              <p class="mini-cart__panel-title">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 15l6-6"/><circle cx="9.5" cy="9.5" r="1"/><circle cx="14.5" cy="14.5" r="1"/><rect x="3" y="3" width="18" height="18" rx="4"/></svg>
                {{ 'sections.cart_page.coupon' | t }}
              </p>
              <label class="visually-hidden" for="CartDrawer-Coupon">{{ 'sections.cart_page.coupon' | t }}</label>
              <input id="CartDrawer-Coupon" type="text" class="mini-cart__input" autocomplete="off" data-mini-coupon>
              <p class="mini-cart__hint">{{ 'sections.cart_page.coupon_hint' | t }}</p>
              <div class="mini-cart__panel-actions">
                <button type="button" class="mini-cart__btn mini-cart__btn--outline" data-mini-panel-close>{{ 'customer.addresses.cancel' | t }}</button>
                <button type="button" class="mini-cart__btn mini-cart__btn--dark" data-mini-coupon-save>{{ 'sections.mini_cart.save' | t }}</button>
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <p class="visually-hidden" id="CartDrawer-LiveRegionText" role="status"></p>
  <p class="visually-hidden" id="CartDrawer-LineItemStatus" aria-live="polite" aria-hidden="true" role="status">
    {{ 'accessibility.loading' | t }}
  </p>
</cart-drawer>
