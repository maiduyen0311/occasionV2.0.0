{%- comment -%}
  Resolve + render category sidebar icon for a menu link.
  Accepts: link {Object} optional, match_title {String} optional, section {Object}
{%- endcomment -%}

{%- liquid
  assign icon_image = blank
  assign lookup_title = match_title

  if lookup_title == blank and link != blank
    assign lookup_title = link.title
  endif

  assign link_title = lookup_title | strip | downcase

  for block in section.blocks
    if block.type == 'category_icon'
      assign match = block.settings.match_title | strip | downcase
      if match != blank and match == link_title and block.settings.icon_image != blank
        assign icon_image = block.settings.icon_image
        break
      endif
    endif
  endfor
-%}

{%- liquid
  # Occasion: optional icon file per menu item, named after the link handle (e.g. fashion-clothing.png in Content › Files)
  assign icon_url = blank
  if icon_image == blank and section.settings.icons_from_files and link != blank
    assign icon_url = link.handle | append: '.png' | file_url
  endif
-%}
{%- if icon_url != blank -%}
  <span class="header-bottom__sidebar-icon header-bottom__sidebar-icon--file" aria-hidden="true"><img src="{{ icon_url }}" alt="" width="18" height="18" loading="lazy"></span>
{%- else -%}
  {% render 'category-nav-icon', image: icon_image %}
{%- endif -%}
