{%- comment -%}
  Shop by Categories — sidebar + flyout mega menu (mockup layout).

  Menu structure (Navigation → categories_menu):
  • Level 1 — sidebar row (Women's, Men's, Clothing…)
  • Level 2 — column heading in flyout (Women's Fashion, Bottoms…)
  • Level 3 — links under each heading

  A level-1 item opens a flyout only when it has sub-links or a matching
  "Mega menu style 1–4" block (match_title): the block's style when there is
  one, otherwise plain link columns. Other items are direct links, and the
  white flyout area stays hidden while they are hovered (categories-menu.js).
  Optional blocks map sidebar icons by matching menu link title.

  Accepts: section {Object}
{%- endcomment -%}

{%- liquid
  assign categories_label = section.settings.categories_label | default: 'All Categories'
  assign categories_menu = section.settings.categories_menu
  assign sidebar_visible_limit = section.settings.categories_visible | default: 10
  assign more_label = section.settings.categories_more_label | default: 'See more'
  assign less_label = section.settings.categories_less_label | default: 'See less'

  # Occasion homepage: the list stays open under the button (fills the hero's left column)
  assign pinned = false
  if section.settings.open_on_home and template.name == 'index'
    assign pinned = true
  endif

  # "|women's|men's|" — titles that own a Mega menu block
  assign mega_keys = '|'
  for block in section.blocks
    if block.type contains 'megamenu_' and block.settings.match_title != blank
      assign mega_keys = mega_keys | append: block.settings.match_title | strip | downcase | append: '|'
    endif
  endfor
-%}

<div class="header-bottom__categories{% if pinned %} header-bottom__categories--pinned{% endif %}{% if section.settings.categories_style == 'plain' %} header-bottom__categories--plain{% endif %}{% if section.settings.categories_style == 'lines' %} header-bottom__categories--lines{% endif %}"{% if section.settings.categories_more_color != blank %} style="--categories-more-color: {{ section.settings.categories_more_color }};"{% endif %} data-header-categories{% if pinned %} data-categories-pinned{% endif %}>
  <button
    type="button"
    class="header-bottom__categories-btn"
    data-categories-toggle
    aria-expanded="false"
    aria-controls="HeaderBottomCategoriesPanel"
  >
    <span class="header-bottom__categories-icon" aria-hidden="true">
      {% render 'oc-icon', name: 'menu' %}
    </span>
    {%- comment -%} "Icons with dividers": an X while the list is open (Occasion 1.x) {%- endcomment -%}
    <span class="header-bottom__categories-icon header-bottom__categories-icon--close" aria-hidden="true">
      {% render 'oc-icon', name: 'close' %}
    </span>
    <span class="header-bottom__categories-label">{{ categories_label }}</span>
    {%- if section.settings.show_categories_caret -%}
      <span class="header-bottom__categories-caret" aria-hidden="true">
        {% render 'svg', name: 'chevron-down-xs' %}
      </span>
    {%- endif -%}
  </button>

  <div
    id="HeaderBottomCategoriesPanel"
    class="header-bottom__mega"
    data-categories-panel
    {% unless pinned %}hidden{% endunless %}
  >
    <div class="header-bottom__mega-layout">
      <nav class="header-bottom__sidebar" aria-label="{{ categories_label | escape }}">
        <ul class="header-bottom__sidebar-list" role="list" data-categories-sidebar-list>
          {%- if categories_menu != blank and categories_menu.links.size > 0 -%}
            {%- assign flyout_index = 0 -%}
            {%- for link in categories_menu.links -%}
              {%- liquid
                assign has_mega = false
                assign link_key = '|' | append: link.title | strip | downcase | append: '|'
                assign sub_count = link.links.size
                if sub_count == 0
                  assign sub_count = linklists[link.handle].links.size
                endif
                # Two-level item (sub-links without their own sub-links, no Mega menu block):
                # a compact list beside the row instead of the wide flyout
                assign simple_sub = false
                if link.links.size > 0
                  unless mega_keys contains link_key
                    assign simple_sub = true
                    for sub in link.links
                      if sub.links.size > 0
                        assign simple_sub = false
                        break
                      endif
                    endfor
                  endunless
                endif
                if simple_sub == false
                  if sub_count > 0 or mega_keys contains link_key
                    assign has_mega = true
                  endif
                endif
              -%}

              <li
                class="header-bottom__sidebar-item{% if has_mega %} has-mega{% endif %}{% if simple_sub %} header-bottom__sidebar-item--sub{% endif %}{% if forloop.index > sidebar_visible_limit %} header-bottom__sidebar-item--collapsed{% endif %}"
                {% if has_mega %}
                  data-mega-sidebar-item
                  data-mega-index="{{ flyout_index }}"
                {% endif %}
              >
                {%- if has_mega -%}
                  <a
                    href="{{ link.url }}"
                    class="header-bottom__sidebar-link"
                    data-mega-sidebar-link
                  >
                    {% render 'category-nav-icon-for-link', link: link, section: section %}
                    <span class="header-bottom__sidebar-text">{{ link.title | escape }}</span>
                    <span class="header-bottom__sidebar-indicator header-bottom__sidebar-indicator--chevron" aria-hidden="true">
                      <span class="header-bottom__sidebar-chevron header-bottom__sidebar-chevron--down">
                        {% render 'svg', name: 'chevron-down-xs' %}
                      </span>
                      <span class="header-bottom__sidebar-chevron header-bottom__sidebar-chevron--right">
                        {% render 'oc-icon', name: 'caret-right' %}
                      </span>
                      <span class="header-bottom__sidebar-chevron header-bottom__sidebar-chevron--line">{% render 'svg', name: 'chevron-right' %}</span>
                    </span>
                  </a>
                  {%- assign flyout_index = flyout_index | plus: 1 -%}
                {%- elsif simple_sub -%}
                  <a href="{{ link.url }}" class="header-bottom__sidebar-link" aria-haspopup="true">
                    {% render 'category-nav-icon-for-link', link: link, section: section %}
                    <span class="header-bottom__sidebar-text">{{ link.title | escape }}</span>
                    <span class="header-bottom__sidebar-indicator header-bottom__sidebar-indicator--chevron" aria-hidden="true">
                      <span class="header-bottom__sidebar-chevron header-bottom__sidebar-chevron--right">
                        {% render 'oc-icon', name: 'caret-right' %}
                      </span>
                      <span class="header-bottom__sidebar-chevron header-bottom__sidebar-chevron--line">{% render 'svg', name: 'chevron-right' %}</span>
                    </span>
                  </a>
                  <ul class="header-bottom__sidebar-sub" role="list">
                    {%- for sub in link.links -%}
                      <li>
                        <a href="{{ sub.url }}" class="header-bottom__sidebar-sublink{% if sub.active %} is-active{% endif %}">{{ sub.title | escape }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  {%- comment -%} Occasion 1.x menus end with a "See more" link: accent colour {%- endcomment -%}
                  <a href="{{ link.url }}" class="header-bottom__sidebar-link{% if link.handle == 'see-more' %} header-bottom__sidebar-link--more{% endif %}">
                    {% render 'category-nav-icon-for-link', link: link, section: section %}
                    <span class="header-bottom__sidebar-text">{{ link.title | escape }}</span>
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}

            {%- if categories_menu.links.size > sidebar_visible_limit -%}
              <li class="header-bottom__sidebar-item header-bottom__sidebar-item--more">
                <button
                  type="button"
                  class="header-bottom__sidebar-link"
                  data-categories-more
                  aria-expanded="false"
                  data-more-label="{{ more_label | escape }}"
                  data-less-label="{{ less_label | escape }}"
                >
                  <span class="header-bottom__sidebar-text" data-categories-more-label>{{ more_label | escape }}</span>
                  <span class="header-bottom__sidebar-indicator header-bottom__sidebar-indicator--toggle" aria-hidden="true">
                    <span class="header-bottom__sidebar-toggle-icon" data-categories-more-icon-plus>
                      {% render 'svg', name: 'plus' %}
                    </span>
                    <span class="header-bottom__sidebar-toggle-icon" data-categories-more-icon-minus hidden>
                      {% render 'svg', name: 'minus' %}
                    </span>
                  </span>
                </button>
              </li>
            {%- endif -%}
          {%- else -%}
            {% render 'header-categories-demo-sidebar',
              section: section,
              sidebar_visible_limit: sidebar_visible_limit,
              more_label: more_label,
              less_label: less_label
            %}
          {%- endif -%}
        </ul>
      </nav>

      <div class="header-bottom__mega-body" data-mega-body>
        {%- if categories_menu != blank -%}
          {%- assign panel_index = 0 -%}
          {%- for link in categories_menu.links -%}
            {%- liquid
              assign link_key = '|' | append: link.title | strip | downcase | append: '|'
              assign sub_count = link.links.size
              if sub_count == 0
                assign sub_count = linklists[link.handle].links.size
              endif
              # Same test as the sidebar: two-level items have no flyout panel
              assign simple_sub = false
              if link.links.size > 0
                unless mega_keys contains link_key
                  assign simple_sub = true
                  for sub in link.links
                    if sub.links.size > 0
                      assign simple_sub = false
                      break
                    endif
                  endfor
                endunless
              endif
            -%}
            {%- if simple_sub -%}{%- continue -%}{%- endif -%}
            {%- if sub_count > 0 or mega_keys contains link_key -%}
              <div class="header-bottom__flyout" data-mega-flyout data-mega-index="{{ panel_index }}" hidden>
                {%- if mega_keys contains link_key -%}
                  {% render 'header-mega-flyout-dispatch', link: link, section: section %}
                {%- else -%}
                  {%- comment -%} Sub-links without a Mega menu block: plain link columns {%- endcomment -%}
                  {%- assign simple_cols = sub_count | at_most: 5 -%}
                  <div class="header-bottom__flyout-panel header-bottom__flyout-panel--simple">
                    {% render 'header-mega-links', link: link, columns: simple_cols %}
                  </div>
                {%- endif -%}
              </div>
              {%- assign panel_index = panel_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if categories_menu == blank or categories_menu.links.size == 0 -%}
          {% render 'header-categories-demo-flyouts', section: section %}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
