{%- comment -%}
  Header middle — account (+ dropdown), wishlist, cart
  Accepts: section {Object}
{%- endcomment -%}

{%- liquid
  assign show_account = section.settings.show_account
  assign show_wishlist = section.settings.show_wishlist
  assign show_cart = section.settings.show_cart
  assign wishlist_url = section.settings.wishlist_url | default: '/pages/wishlist'
  assign wishlist_count = section.settings.wishlist_count | default: 0
  assign account_dropdown = section.settings.show_account_dropdown
  assign show_compare = section.settings.show_compare
  assign compare_url = section.settings.compare_url | default: '/pages/compare'
  assign cart_style = section.settings.cart_style | default: 'total'
-%}

<nav class="header-middle__actions{% unless section.settings.show_action_labels %} header-middle__actions--no-labels{% endunless %} header-middle__actions--cart-{{ cart_style }}" aria-label="{{ 'sections.header.utility_navigation' | t | default: 'Store navigation' }}">
  <ul class="header-middle__actions-list" role="list">
    {%- if show_account -%}
      <li class="header-middle__actions-item{% if account_dropdown %} header-account{% endif %}"{% if account_dropdown %} data-account-dropdown{% endif %}>
        <a
          href="{{ routes.account_url }}"
          class="header-middle__action-link"
          {% if account_dropdown %}aria-haspopup="dialog" aria-expanded="false" aria-controls="HeaderAccountPanel"{% endif %}
        >
          <span class="header-middle__action-icon" aria-hidden="true">
            {% render 'svg', name: 'user' %}
          </span>
          <span class="header-middle__action-label">{{ section.settings.account_label | default: 'Account' }}</span>
        </a>
        {%- if account_dropdown -%}
          {% render 'header-account-dropdown', section: section %}
        {%- endif -%}
      </li>
    {%- endif -%}

    {%- if show_wishlist -%}
      <li class="header-middle__actions-item">
        <a href="{{ wishlist_url }}" class="header-middle__action-link">
          <span class="header-middle__action-icon header-middle__action-icon--badge" aria-hidden="true">
            {% render 'svg', name: 'heart' %}
            {%- if section.settings.show_wishlist_count -%}<span class="header-middle__badge" data-wishlist-count>{{ wishlist_count }}</span>{%- endif -%}
          </span>
          <span class="header-middle__action-label">{{ section.settings.wishlist_label | default: 'Wishlist' }}</span>
        </a>
      </li>
    {%- endif -%}

    {%- if show_compare -%}
      <li class="header-middle__actions-item">
        <a href="{{ compare_url }}" class="header-middle__action-link">
          <span class="header-middle__action-icon header-middle__action-icon--badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h15M15 4l4 4-4 4M20 16H5M9 12l-4 4 4 4"/></svg>
            <span class="header-middle__badge" data-compare-count>0</span>
          </span>
          <span class="header-middle__action-label">{{ section.settings.compare_label | default: 'Compare' }}</span>
        </a>
      </li>
    {%- endif -%}

    {%- if show_cart -%}
      <li class="header-middle__actions-item header-middle__actions-item--cart">
        {%- comment -%}
          `id="cart-icon-bubble"` is Dawn's hook: cart-drawer.js binds clicks on it
          and cart.js re-renders its innerHTML from sections/cart-icon-bubble.liquid
          after every cart change — so it sits on the icon only. The cart total
          ([data-cart-total]) is copied from the bubble by mini-cart.js.
          The whole link opens the drawer via [data-cart-drawer-toggle].
        {%- endcomment -%}
        <a href="{{ routes.cart_url }}" class="header-middle__action-link" data-cart-drawer-toggle>
          <span class="header-middle__action-icon header-middle__action-icon--badge" id="cart-icon-bubble" aria-hidden="true">
            {% render 'svg', name: 'bag' %}
            <span class="header-middle__badge cart-count" data-cart-count>{{ cart.item_count }}</span>
            <span class="visually-hidden" data-cart-total-source>{{ cart.total_price | money }}</span>
          </span>
          {%- if cart_style == 'total' -%}
            <span class="header-middle__cart-text">
              <span class="header-middle__cart-label">{{ section.settings.cart_label | default: 'My cart' }}</span>
              <span class="header-middle__cart-total" data-cart-total>{{ cart.total_price | money }}</span>
            </span>
          {%- else -%}
            <span class="header-middle__action-label">{{ section.settings.cart_label | default: 'Cart' }}</span>
          {%- endif -%}
        </a>
      </li>
    {%- endif -%}
  </ul>
</nav>
