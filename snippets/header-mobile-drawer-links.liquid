{%- comment -%}
  Accordion list for the mobile drawer (main menu and Shop by Categories).
  Each row is a link; rows with children get a +/− button that opens the
  nested list (mobile-drawer.js). Renders itself for levels 2 and 3.

  Accepts:
  - links {Array} menu links
  - id_prefix {String} unique prefix for the nested list ids
  - level {Number} 1–3 (default 1)
{%- endcomment -%}

{%- liquid
  assign level = level | default: 1
  assign next_level = level | plus: 1
-%}
<ul class="mobile-drawer__list mobile-drawer__list--level-{{ level }} list-unstyled" role="list">
  {%- for link in links -%}
    {%- liquid
      assign sub_id = id_prefix | append: '-' | append: forloop.index
      # Nested menu, or the legacy menu named after the link (Occasion 1.x stores)
      assign children = link.links
      if children.size == 0 and linklists[link.handle].links.size > 0
        assign children = linklists[link.handle].links
      endif
    -%}
    {%- liquid
      # Accent only for the current page; parents of a "/" sub-link are not current on the homepage
      assign row_active = link.current
      if link.child_current and request.page_type != 'index'
        assign row_active = true
      endif
    -%}
    <li class="mobile-drawer__item">
      <div class="mobile-drawer__row">
        <a
          href="{{ link.url }}"
          class="mobile-drawer__row-link{% if row_active %} is-active{% endif %}"
          {% if link.current %}
            aria-current="page"
          {% endif %}
        >
          <span>{{ link.title | escape }}</span>
        </a>
        {%- if children.size > 0 and level < 3 -%}
          <button
            type="button"
            class="mobile-drawer__expand"
            aria-expanded="false"
            aria-controls="{{ sub_id }}"
            aria-label="{{ link.title | escape }}"
            data-mobile-drawer-expand
          >
            <span class="mobile-drawer__plus" aria-hidden="true"></span>
          </button>
        {%- endif -%}
      </div>
      {%- if children.size > 0 and level < 3 -%}
        <div id="{{ sub_id }}" class="mobile-drawer__sub" hidden>
          {% render 'header-mobile-drawer-links',
            links: children,
            id_prefix: sub_id,
            level: next_level
          %}
        </div>
      {%- endif -%}
    </li>
  {%- endfor -%}
</ul>
