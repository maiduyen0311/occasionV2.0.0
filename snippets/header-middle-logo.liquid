{%- comment -%}
  Header middle — logo block
  Accepts: section {Object}
{%- endcomment -%}

{%- liquid
  assign logo_top = section.settings.logo_text_top | default: 'TOP'
  assign logo_bottom = section.settings.logo_text_bottom | default: 'market'
-%}

<div class="header-middle__logo">
  {%- assign logo_alt_text = settings.store_display_name | default: shop.name -%}
  <a href="{{ routes.root_url }}" class="header-middle__logo-link" aria-label="{{ settings.store_display_name | default: shop.name | escape }}">
    {%- if section.settings.logo_image != blank -%}
      {{
        section.settings.logo_image
        | image_url: width: 240
        | image_tag:
          class: 'header-middle__logo-image',
          widths: '120, 180, 240',
          alt: logo_alt_text,
          loading: 'eager'
      }}
    {%- else -%}
      {%- if logo_top == 'TOP' and logo_bottom == 'market' -%}
        <span class="header-middle__logo-mark">{% render 'logo-topmarket' %}</span>
      {%- else -%}
      <span class="header-middle__logo-text" aria-hidden="true">
        <span class="header-middle__logo-top">
          {%- if logo_top == 'TOP' -%}
            T<span class="header-middle__logo-o"><span class="header-middle__logo-o-dot"></span>O</span>P
          {%- else -%}
            {{ logo_top }}
          {%- endif -%}
        </span>
        <span class="header-middle__logo-bottom">{{ logo_bottom }}</span>
      </span>
      {%- endif -%}
    {%- endif -%}
  </a>
</div>
