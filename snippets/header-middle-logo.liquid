{%- comment -%}
  Header middle — logo block: logo image, or the logo text setting, or the
  Occasion SVG wordmark (snippets/logo-occasion.liquid).
  Accepts: section {Object}
{%- endcomment -%}

{%- assign logo_alt_text = settings.store_display_name | default: shop.name -%}
<div class="header-middle__logo" style="--header-middle-logo-max: {{ section.settings.logo_max_width | default: 160 }}px;">
  <a href="{{ routes.root_url }}" class="header-middle__logo-link" aria-label="{{ logo_alt_text | escape }}">
    {%- if section.settings.logo_image != blank -%}
      {{
        section.settings.logo_image
        | image_url: width: 600
        | image_tag:
          class: 'header-middle__logo-image',
          widths: '160, 240, 320, 480, 600',
          sizes: '(min-width: 992px) 300px, 200px',
          alt: logo_alt_text,
          loading: 'eager'
      }}
    {%- elsif section.settings.logo_text != blank -%}
      <span class="header-middle__logo-text">{{ section.settings.logo_text | escape }}</span>
    {%- else -%}
      <span class="header-middle__logo-mark">{% render 'logo-occasion' %}</span>
    {%- endif -%}
  </a>
</div>
