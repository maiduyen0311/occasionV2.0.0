    "faq": {
      "type": "faq-accordion",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Most orders ship within 1 business day and arrive in 3–5 business days for domestic addresses. Express options are available at checkout.</p>",
            "open_by_default": true
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>You can return any unworn item within 30 days for a full refund. Returns are free for orders shipped within the US.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>Yes — we ship to over 120 countries. Duties and taxes are calculated at checkout so there are no surprises on delivery.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "How can I track my order?",
            "answer": "<p>Once your order ships, you'll receive a confirmation email with a tracking link. You can also log into your account to see real-time status.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Do you offer gift wrapping?",
            "answer": "<p>Yes — select \"Gift wrap\" at checkout. We use 100% recyclable paper with a handwritten note option for an extra $4.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "How do I redeem a discount code?",
            "answer": "<p>Enter your code in the \"Discount\" field at checkout — it'll be applied to your subtotal before shipping and taxes.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5",
        "q6"
