  {
    "name": "Occasion — Localization",
    "settings": [
      {
        "type": "paragraph",
        "content": "Shopify chooses the country (currency) from the visitor's location. With this on, first-time visitors get the defaults below until they pick a currency or language in the header."
      },
      {
        "type": "checkbox",
        "id": "force_default_localization",
        "label": "Use the default currency and language for new visitors",
        "default": true
      },
      {
        "type": "text",
        "id": "default_country",
        "label": "Default country (ISO code)",
        "info": "Its market currency is used, e.g. US → USD. The country must be in one of your markets.",
        "default": "US"
      },
      {
        "type": "text",
        "id": "default_language",
        "label": "Default language (ISO code)",
        "info": "e.g. en. Must be a published language.",
        "default": "en"
      }
    ]
  },
  {
    "name": "Occasion — Colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "Core brand palette. Exposed as CSS variables (--color-primary, --color-secondary, --color-heading, --color-text, --color-product-title) for sections and other Theme settings."
      },
      {
        "type": "header",
        "content": "Brand colors"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary color",
        "info": "Buttons, links, accents, sale badges. CSS: --color-primary, --color-accent.",
        "default": "#fb9455"
      },
      {
        "type": "color",
        "id": "color_accent_custom",
        "label": "Accent color (optional)",
        "info": "Prices, links, active tabs, badges and highlights. Leave empty to use the primary color. Buttons and dark backgrounds keep the primary color."
      },
      {
        "type": "color",
        "id": "color_accent_contrast",
        "label": "Text on accent color (optional)",
        "info": "Text and icons on accent backgrounds (badges, hover buttons). Leave empty for white. Use a dark color with a light accent such as lime or yellow."
      },
      {
        "type": "color",
        "id": "color_accent_ink",
        "label": "Accent text on light backgrounds (optional)",
        "info": "Eyebrows, links and highlights written in the accent color on white. Leave empty to use the accent color. Use a deeper shade when the accent is very light.",
        "default": "#fb9455"
      },
      {
        "type": "color",
        "id": "color_price",
        "label": "Price color (optional)",
        "info": "Leave empty to use the accent color."
      },
      {
        "type": "color",
        "id": "color_badge_sale",
        "label": "Discount badge color (optional)",
        "info": "Background of the -% badge on product cards. Empty: accent color."
      },
      {
        "type": "color",
        "id": "color_page_background",
        "label": "Page background (optional)",
        "info": "Background behind sections that have no color scheme of their own. Leave empty for white."
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary color",
        "info": "Secondary actions, success/new badges. CSS: --color-secondary, --color-new.",
        "default": "#bbd8b2"
      },
      {
        "type": "header",
        "content": "Typography colors"
      },
      {
        "type": "color",
        "id": "color_heading",
        "label": "Heading color",
        "info": "Section titles, h1–h6. CSS: --color-heading.",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_text",
