  {
    "name": "t:settings_schema.cards.name",
    "settings": [
      {
        "type": "select",
        "id": "corner_style",
        "label": "Corner style (whole store)",
        "options": [
          {
            "value": "default",
            "label": "Default"
          },
          {
            "value": "square",
            "label": "Square (no rounded corners)"
          }
        ],
        "default": "default",
        "info": "Square removes rounded corners from buttons, inputs, images, cards and banners. Counters, dots and avatars stay round."
      },
      {
        "type": "select",
        "id": "card_layout",
        "label": "Card layout",
        "options": [
          {
            "value": "classic",
            "label": "Classic (stars, title, price, colors)"
          },
          {
            "value": "minimal",
            "label": "Minimal (reviews, colors, title, price)"
          },
          {
            "value": "occasion",
            "label": "Occasion (round buttons over the image)"
          }
        ],
        "default": "classic",
        "info": "Minimal: left-aligned info, square swatches, quick view / wishlist / cart icons on hover, \"SALE xx%\" label."
      },
      {
        "type": "select",
        "id": "card_badge_style",
        "label": "Minimal card label style",
        "options": [
          {
            "value": "outline",
            "label": "White label, sale-red text"
          },
          {
            "value": "accent",
            "label": "Accent label, contrast text"
          }
        ],
        "default": "outline"
      },
      {
        "type": "select",
        "id": "card_style",
        "options": [
          {
            "value": "standard",
            "label": "t:settings_schema.cards.settings.style.options__1.label"
          },
          {
            "value": "card",
            "label": "t:settings_schema.cards.settings.style.options__2.label"
          }
        ],
        "default": "standard",
        "label": "t:settings_schema.cards.settings.style.label"
      },
      {
        "type": "select",
        "id": "card_text_alignment",
        "options": [
          {
            "value": "left",
            "label": "t:settings_schema.global.settings.text_alignment.options__1.label"
          },
          {
            "value": "center",
            "label": "t:settings_schema.global.settings.text_alignment.options__2.label"
          },
          {
            "value": "right",
            "label": "t:settings_schema.global.settings.text_alignment.options__3.label"
          }
        ],
        "default": "center",
        "label": "t:settings_schema.global.settings.text_alignment.label"
      },
      {
        "type": "select",
        "id": "card_image_fit",
        "label": "Product image fit",
        "options": [
          {
            "value": "contain",
            "label": "Contain (cut-out product photos)"
          },
          {
            "value": "cover",
            "label": "Cover (lifestyle photos fill the image box)"
          }
        ],
        "default": "contain"
      },
      {
        "type": "range",
        "id": "card_image_padding",
        "min": 0,
        "max": 25,
        "step": 1,
        "unit": "%",
        "label": "Product image padding",
        "default": 0,
        "info": "White space around cut-out product photos inside the image box."
      },
      {
        "type": "color_scheme",
        "id": "card_color_scheme",
        "label": "t:sections.all.colors.label",
        "default": "scheme-2"
      },
      {
        "type": "header",
        "content": "t:settings_schema.global.settings.header__border.content"
      },
      {
        "type": "header",
        "content": "t:settings_schema.global.settings.header__shadow.content"
      }
    ]
  },
