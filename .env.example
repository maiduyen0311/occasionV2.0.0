# Shopify dev preview — used by `npm run dev` / `npm run serve`
# Copy to .env and set your development store. Do NOT commit .env.
SHOPIFY_FLAG_STORE=your-store-name.myshopify.com

# Local preview URL: http://127.0.0.1:9293 (auto-reload on .liquid / .scss save)
SHOPIFY_DEV_PORT=9293

# hot-reload = CSS updates without F5 (default). full-page = refresh whole page on any file save.
SHOPIFY_LIVE_RELOAD=hot-reload

# Pin remote theme ID (dev/unpublished theme on shop)
# SHOPIFY_FLAG_THEME=123456789

# Deploy local → Shopify (run `npm run build` is included):
#   npm run deploy:preview  — push to SHOPIFY_FLAG_THEME (safe: preview before publish)
#   npm run deploy:live     — push to published live theme (--live)
# Do NOT use theme:pull:live unless you want shop → local (overwrites your work).

# Optional: switch between stores quickly
# SHOPIFY_FLAG_STORE_STAGING=your-staging-store.myshopify.com
