{%- comment -%}
  Products from a collection as a grid or a carousel — design/SPEC.md §2.7 (carousel, 6 per row,
  thin arrows outside the container) and §2.9 (Trending items, 5 columns × 2 rows).
  Carousel: <tm-scroller> (common/js/modules/tm-scroller.js).
{%- endcomment -%}

{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
  assign layout = section.settings.layout
  assign cols = section.settings.columns_desktop
  assign cols_md = cols | at_most: 4
  assign cols_sm = section.settings.columns_mobile | plus: 0
  # "Load more" (grid): render up to 48 products, the ones past the first rows stay hidden
  assign load_more = false
  if layout != 'carousel' and section.settings.show_view_all and section.settings.view_all_action == 'load_more' and collection != blank
    assign load_more = true
  endif
  assign render_limit = limit
  if load_more
    assign render_limit = 48
  endif
-%}

{%- style -%}
  #ProductGrid-{{ section.id }} {
    --section-pt: {{ section.settings.padding_top }}px;
    --section-pb: {{ section.settings.padding_bottom }}px;
    {%- if section.settings.title_color != blank %}
      --color-product-title: {{ section.settings.title_color }};
    {%- endif %}
  }

  #ProductGrid-{{ section.id }} .oc-product-grid__list {
    --bs-gutter-y: {{ section.settings.row_gap | default: 17 }}px;
    --bs-gutter-x: {{ section.settings.column_gap | default: 17 }}px;
  }
{%- endstyle -%}

<section id="ProductGrid-{{ section.id }}" class="oc-product-grid oc-product-grid--{{ layout }} oc-product-grid--info-{{ section.settings.card_info | default: 'full' }}{% if section.settings.boxed %} oc-product-grid--boxed{% endif %} oc-section section-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="container">
    {% render 'oc-heading', title: section.settings.title, size: section.settings.heading_size, accent: section.settings.heading_accent, rule: section.settings.heading_rule %}

    {%- capture items -%}
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: render_limit -%}
          <li class="oc-product-grid__item"{% if forloop.index > limit %} hidden{% endif %}>
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: 'square',
              show_secondary_image: section.settings.show_secondary_image,
              show_rating: section.settings.show_rating,
              show_wishlist: true,
              show_color_swatches: section.settings.show_swatches,
              section_id: section.id
            %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <li class="oc-product-grid__item">
            <div class="oc-product-grid__placeholder">
              {%- assign ph = i | modulo: 6 | plus: 1 -%}
              {{ 'product-' | append: ph | placeholder_svg_tag: 'oc-product-grid__placeholder-svg' }}
              <p class="oc-product-grid__placeholder-title">{{ 'onboarding.product_title' | t }}</p>
              <p class="oc-price oc-product-grid__placeholder-price"><span class="oc-price__current">{{ 1999 | money }}</span></p>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}

    {%- if layout == 'carousel' -%}
      <tm-scroller
        class="tm-scroller tm-product-scroller oc-product-grid__scroller"
        style="--per-view: {{ cols }}; --per-view-md: {{ cols_md }}; --per-view-sm: {{ cols_sm }}; --gap: 17px;"
      >
        {%- unless section.settings.show_arrows == false -%}
          {% render 'tm-scroller-nav', class: 'oc-product-grid__nav' %}
        {%- endunless -%}
        <ul class="tm-scroller__track" role="list" data-scroller-track>
          {{ items }}
        </ul>
      </tm-scroller>
    {%- else -%}
      <ul
        class="oc-product-grid__list row row-cols-{{ cols_sm }} row-cols-md-{{ cols_md }} row-cols-lg-{{ cols }} gx-4 gy-5 list-unstyled"
        role="list"
        {% if load_more %}id="ProductGridList-{{ section.id }}" data-load-more-step="{{ limit }}"{% endif %}
      >
        {{ items }}
      </ul>
    {%- endif -%}

    {%- if load_more and collection.products_count <= limit -%}
      {%- comment -%} Nothing more to load {%- endcomment -%}
    {%- elsif load_more -%}
      <div class="oc-product-grid__more">
        <button type="button" class="oc-btn{% if section.settings.view_all_style == 'outline' %} oc-btn--outline{% endif %}" data-load-more="ProductGridList-{{ section.id }}">
          {%- if section.settings.view_all_label != blank -%}
            {{ section.settings.view_all_label | escape }}
          {%- else -%}
            {{ 'sections.featured_collection.view_all' | t }}
          {%- endif -%}
        </button>
      </div>
    {%- elsif section.settings.show_view_all and collection != blank -%}
      <div class="oc-product-grid__more">
        <a href="{{ collection.url }}" class="oc-btn{% if section.settings.view_all_style == 'outline' %} oc-btn--outline{% endif %}">
          {%- if section.settings.view_all_label != blank -%}
            {{ section.settings.view_all_label | escape }}
          {%- else -%}
            {{ 'sections.featured_collection.view_all' | t }}
          {%- endif -%}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product grid / carousel",
  "tag": "div",
  "class": "section-oc-product-grid",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Trending Items"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "heading_accent",
      "label": "Heading underline color",
      "info": "Empty: theme secondary color."
    },
    {
      "type": "checkbox",
      "id": "heading_rule",
      "label": "Show grey line under the heading",
      "default": true
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Products per row on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Products per row on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "card_info",
      "label": "Card details",
      "options": [
        {
          "value": "full",
          "label": "Stars, title and price"
        },
        {
          "value": "price",
          "label": "Title and price"
        },
        {
          "value": "title",
          "label": "Title only"
        }
      ],
      "default": "full"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "Show color swatches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product rating",
      "default": false,
      "info": "Needs a product reviews app."
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 17,
      "info": "Grid layout only."
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Space between rows",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 17,
      "info": "Grid layout."
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Product title color",
      "info": "Empty: Theme settings → Colors."
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View all button",
      "default": false
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all button label",
      "info": "Empty: \"View all\" in the store language."
    },
    {
      "type": "select",
      "id": "view_all_action",
      "label": "View all button action",
      "info": "Load more (grid layout): shows the next rows of the collection on the page, as many as Products to show each time.",
      "options": [
        { "value": "link", "label": "Open the collection" },
        { "value": "load_more", "label": "Load more products" }
      ],
      "default": "link"
    },
    {
      "type": "select",
      "id": "view_all_style",
      "label": "View all button style",
      "options": [
        {
          "value": "button",
          "label": "Accent button"
        },
        {
          "value": "outline",
          "label": "Outline box"
        }
      ],
      "default": "button"
    },
    {
      "type": "checkbox",
      "id": "boxed",
      "label": "Frame the products",
      "default": false,
      "info": "Thin border around the grid or carousel."
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show carousel arrows",
      "default": true
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Product grid / carousel"
    }
  ]
}
{% endschema %}
