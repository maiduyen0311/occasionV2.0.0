
{%- if section.settings.show_color_swatches -%}
{%- endif -%}

{% if section.settings.image_shape == 'blob' %}
{%- endif -%}

{%- style -%}
  #NewProducts-{{ section.id }} {
    --section-pt: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --section-pb: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    --accent: {{ section.settings.accent_color | default: '#dc5414' }};
    --columns-desktop: {{ section.settings.columns_desktop }};
    --columns-mobile: {{ section.settings.columns_mobile }};
    --gap: 20px;
  }

  @media screen and (min-width: 750px) {
    #NewProducts-{{ section.id }} {
      --section-pt: {{ section.settings.padding_top }}px;
      --section-pb: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign products_limit = section.settings.products_to_show
  assign collection = section.settings.collection
  assign view_all_url = section.settings.view_all_link
  if view_all_url == blank and collection != blank
    assign view_all_url = collection.url
  endif
-%}

<section
  id="NewProducts-{{ section.id }}"
  class="home-new-products section-{{ section.id }} section-home-new-products color-{{ section.settings.color_scheme }} isolate"
  data-section-id="{{ section.id }}"
>
  <div class="{% if section.settings.full_width %}container-fluid{% else %}container{% endif %}">
    <div class="home-new-products__inner">
      <header class="home-new-products__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="home-new-products__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="home-new-products__title">{{ section.settings.title }}</h2>
        {%- endif -%}
      </header>

      <div class="collection home-new-products__collection">
        <ul
          class="grid product-grid contains-card contains-card--product{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} home-new-products__grid"
          role="list"
        >
          {% assign skip_card_product_styles = false %}
          {%- if collection != blank and collection.products.size > 0 -%}
            {%- for product in collection.products limit: products_limit -%}
              <li
                id="NewProducts-{{ section.id }}-{{ forloop.index }}"
                class="grid__item home-new-products__item"
              >
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: section.settings.image_ratio,
                  image_shape: section.settings.image_shape,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  show_rating_placeholder: section.settings.show_rating,
                  show_discount_badge: section.settings.show_discount_badge,
                  show_metafield_badge: section.settings.show_metafield_badge,
                  show_auto_new: section.settings.show_auto_new,
                  show_color_swatches: section.settings.show_color_swatches,
                  show_wishlist: section.settings.show_wishlist,
                  skip_styles: skip_card_product_styles,
                  section_id: section.id
                %}
              </li>
              {%- assign skip_card_product_styles = true -%}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..section.settings.columns_desktop) -%}
              <li class="grid__item home-new-products__item">
                {% liquid
                  assign ridx = forloop.rindex
                  case ridx
                    when 5
                      assign ridx = 1
                    when 6
                      assign ridx = 2
                  endcase
                %}
                {%- assign placeholder_image = 'product-apparel-' | append: ridx -%}
                {% render 'card-product',
                  show_vendor: section.settings.show_vendor,
                  media_aspect_ratio: section.settings.image_ratio,
                  image_shape: section.settings.image_shape,
                  placeholder_image: placeholder_image
                %}
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>

      {%- if section.settings.show_view_all and view_all_url != blank -%}
        <div class="home-new-products__footer">
          <a
            href="{{ view_all_url }}"
            class="home-new-products__view-all"
            aria-label="{{ section.settings.view_all_label | escape }}"
          >
            {{ section.settings.view_all_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home new products",
  "tag": "section",
  "class": "section-home-new-products",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow tag"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "New Products"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Number of products",
      "default": 5
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Columns on desktop",
      "default": 5
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "arch",
          "label": "Arch"
        },
        {
          "value": "blob",
          "label": "Blob"
        },
        {
          "value": "round",
          "label": "Round"
        }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product rating",
      "default": true,
      "info": "Shows review rating when available, otherwise 5 placeholder stars."
    },
    {
      "type": "checkbox",
      "id": "show_discount_badge",
      "label": "Show discount badge (percent off)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_metafield_badge",
      "label": "Show metafield badge (NEW/HOT/SALE)",
      "default": true,
      "info": "Reads product metafield `custom.badge`."
    },
    {
      "type": "checkbox",
      "id": "show_auto_new",
      "label": "Auto-show NEW badge for recent products",
      "default": false,
      "info": "Adds NEW badge if product was created in the last 30 days."
    },
    {
      "type": "checkbox",
      "id": "show_color_swatches",
      "label": "Show color swatches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist heart icon",
      "default": true
    },
    {
      "type": "header",
      "content": "View all button"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button label",
      "default": "+ SEE ALL PRODUCTS"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Button link",
      "info": "Leave blank to use the selected collection URL."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#dc5414"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Home new products",
      "settings": {
        "title": "New Products",
        "products_to_show": 5,
        "columns_desktop": 5,
        "columns_mobile": "2",
        "image_ratio": "square",
        "show_secondary_image": true,
        "show_rating": true,
        "show_discount_badge": true,
        "show_metafield_badge": true,
        "show_color_swatches": true,
        "show_wishlist": true,
        "show_view_all": true,
        "view_all_label": "+ SEE ALL PRODUCTS",
        "accent_color": "#dc5414",
        "padding_top": 48,
        "padding_bottom": 48
      }
    }
  ]
}
{% endschema %}
