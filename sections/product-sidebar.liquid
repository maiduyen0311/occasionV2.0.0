{%- comment -%}
  Product page sidebar — design/old-demo/product.png (Occasion 1.x "product-sidebar").
  Breadcrumb across the page, then a 240px left column (Categories menu, Top sellers, banner,
  text). On desktop the product template's <main> becomes two columns (main:has(.oc-product-sidebar),
  common/scss/section/_oc-product.scss) so the product, tabs and related products sit on the right.
  Blocks are rendered by snippets/collection-sidebar-blocks.liquid.
{%- endcomment -%}

<div class="oc-product-sidebar" data-oc-product-sidebar>
  {%- if section.settings.show_breadcrumb -%}
    <div class="page-breadcrumb oc-product-sidebar__crumbs">
      <nav class="page-breadcrumb__inner container" aria-label="{{ 'sections.main_product.breadcrumb' | t }}">
        <a href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a>
        {%- if collection.url -%}
          <span class="page-breadcrumb__sep" aria-hidden="true">/</span>
          <a href="{{ collection.url }}">{{ collection.title }}</a>
        {%- endif -%}
        <span class="page-breadcrumb__sep" aria-hidden="true">/</span>
        <span class="page-breadcrumb__current" aria-current="page">{{ product.title | escape }}</span>
      </nav>
    </div>
  {%- endif -%}

  <aside id="ProductSidebar-{{ section.id }}" class="oc-product-sidebar__aside" aria-label="{{ 'sections.occasion.sidebar' | t }}">
    {% render 'collection-sidebar-blocks', section: section, collection: collection %}
  </aside>
  <button type="button" class="oc-sidebar-toggle" data-oc-sidebar-toggle aria-controls="ProductSidebar-{{ section.id }}" aria-expanded="false" data-show-label="{{ 'sections.occasion.show_sidebar' | t }}" data-hide-label="{{ 'sections.occasion.hide_sidebar' | t }}">{{ 'sections.occasion.show_sidebar' | t }}</button>
</div>

{% schema %}
{
  "name": "Product sidebar",
  "tag": "div",
  "class": "section-oc-product-sidebar",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true,
      "info": "Turn off the breadcrumb in the Product information section to avoid two."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Categories" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
        { "type": "range", "id": "limit", "label": "Items", "min": 3, "max": 20, "step": 1, "default": 12 }
      ]
    },
    {
      "type": "top_sellers",
      "name": "Top sellers",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Top sellers" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 16, "step": 1, "default": 8 },
        { "type": "range", "id": "per_page", "label": "Products per page", "min": 2, "max": 8, "step": 1, "default": 4 }
      ]
    },
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Custom CMS block" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Custom CMS block displayed at the left sidebar on the product page. Put your own content here: text, html, images, media… whatever you like.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product sidebar",
      "blocks": [{ "type": "menu" }, { "type": "top_sellers" }, { "type": "text" }]
    }
  ]
}
{% endschema %}
