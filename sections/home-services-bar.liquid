{%- style -%}
  #ServicesBar-{{ section.id }} {
    --section-pt: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --section-pb: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    --bg: {{ section.settings.background_color }};
    --text: {{ section.settings.text_color }};
    --accent: {{ section.settings.accent_color }};
    --divider: {{ section.settings.accent_color }};
    --title: {{ section.settings.title_color | default: '#ffffff' }};
  }

  @media screen and (min-width: 750px) {
    #ServicesBar-{{ section.id }} {
      --section-pt: {{ section.settings.padding_top }}px;
      --section-pb: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign icon_shipping = '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8h26v22H3z"/><path d="M29 16h9l7 7v7h-16z"/><circle cx="13" cy="34" r="4"/><circle cx="36" cy="34" r="4"/></svg>'
  assign icon_return = '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 24a16 16 0 1 0 5-11.6"/><polyline points="6,6 8,16 18,14"/></svg>'
  assign icon_support = '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 28v-4a16 16 0 0 1 32 0v4"/><path d="M40 28v8a4 4 0 0 1-4 4h-4v-12h4a4 4 0 0 1 4 4z"/><path d="M8 28v8a4 4 0 0 0 4 4h4V28h-4a4 4 0 0 0-4 4z"/></svg>'
  assign icon_customer = '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="24" cy="16" r="8"/><path d="M8 40c0-8 7-14 16-14s16 6 16 14"/></svg>'
  assign icon_gift = '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="6" y="16" width="36" height="8"/><rect x="10" y="24" width="28" height="18"/><path d="M24 16v26"/><path d="M24 16s-6-10-12-6 6 6 12 6zm0 0s6-10 12-6-6 6-12 6z"/></svg>'
  assign icon_secure = '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M24 4 8 10v12c0 10 7 18 16 22 9-4 16-12 16-22V10z"/><polyline points="17,24 22,29 32,19"/></svg>'
  assign icon_clock = '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="24" cy="24" r="18"/><polyline points="24,12 24,24 32,28"/></svg>'
  assign icon_tag = '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 6h16l20 20-16 16L6 22z"/><circle cx="15" cy="15" r="3"/></svg>'
-%}

<section
  id="ServicesBar-{{ section.id }}"
  class="home-services-bar home-services-bar--{{ section.settings.layout | default: 'inline' }} section-{{ section.id }}{% if section.settings.show_dividers %} home-services-bar--dividers{% endif %} color-{{ section.settings.color_scheme }} gradient"
  data-section-id="{{ section.id }}"
>
  <div class="{% if section.settings.full_width %}container-fluid{% else %}container{% endif %}">
    {%- if section.blocks.size > 0 -%}
      <ul class="home-services-bar__list" role="list">
        {%- for block in section.blocks -%}
          {%- assign service_title = block.settings.title -%}
          {%- assign service_subtitle = block.settings.subtitle -%}
          {%- assign service_link = block.settings.link -%}
          {%- assign icon_preset = block.settings.icon -%}

          <li class="service-item" {{ block.shopify_attributes }}>
            {%- if service_link != blank -%}
              <a href="{{ service_link }}" class="service-item__link">
            {%- else -%}
              <div class="service-item__link service-item__link--static">
            {%- endif -%}

              <span class="service-item__icon" aria-hidden="true">
                {%- case icon_preset -%}
                  {%- when 'shipping' -%}{{ icon_shipping }}
                  {%- when 'return' -%}{{ icon_return }}
                  {%- when 'support' -%}{{ icon_support }}
                  {%- when 'customer' -%}{{ icon_customer }}
                  {%- when 'gift' -%}{{ icon_gift }}
                  {%- when 'secure' -%}{{ icon_secure }}
                  {%- when 'clock' -%}{{ icon_clock }}
                  {%- when 'tag' -%}{{ icon_tag }}
                  {%- when 'none' -%}
                    {%- if block.settings.icon_image != blank -%}
                      {{
                        block.settings.icon_image
                        | image_url: width: 96
                        | image_tag:
                          class: 'service-item__icon-image',
                          loading: 'lazy',
                          widths: '32, 64, 96, 128',
                          sizes: '32px',
                          alt: service_title
                      }}
                    {%- endif -%}
                {%- endcase -%}
              </span>

              <span class="service-item__text">
                {%- if service_title != blank -%}
                  <span class="service-item__title">{{ service_title }}</span>
                {%- endif -%}
                {%- if service_subtitle != blank -%}
                  <span class="service-item__subtitle">{{ service_subtitle }}</span>
                {%- endif -%}
              </span>

            {%- if service_link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Home services bar",
  "tag": "section",
  "class": "section-home-services-bar",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#2b2118"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Subtitle text color",
      "default": "#cdb89a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (icon + divider) color",
      "default": "#dc5414"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Item layout",
      "options": [
        {
          "value": "inline",
          "label": "Icon beside the text"
        },
        {
          "value": "stacked",
          "label": "Icon above the text, centred"
        }
      ],
      "default": "inline"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show vertical dividers between items",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon preset",
          "options": [
            {
              "value": "shipping",
              "label": "Shipping / truck"
            },
            {
              "value": "return",
              "label": "Return / refresh"
            },
            {
              "value": "support",
              "label": "Support / headphone"
            },
            {
              "value": "customer",
              "label": "Customer / user"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "secure",
              "label": "Secure / shield"
            },
            {
              "value": "clock",
              "label": "Clock"
            },
            {
              "value": "tag",
              "label": "Tag / discount"
            },
            {
              "value": "none",
              "label": "None (use custom image)"
            }
          ],
          "default": "shipping"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon image",
          "info": "Used when icon preset is set to None. Square SVG/PNG recommended."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "On Order Over $20"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home services bar",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "icon": "shipping",
            "title": "Free Shipping",
            "subtitle": "On Order Over $20"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "return",
            "title": "15 Days Return",
            "subtitle": "Moneyback Guarantee"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "support",
            "title": "Support Team",
            "subtitle": "24/7 Live Support"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "customer",
            "title": "Become Customer",
            "subtitle": "Join Our Community"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header"
    ]
  }
}
{% endschema %}
