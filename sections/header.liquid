{% comment %}
  Header section with utility bar and main header
{% endcomment %}

<header class="header-wrapper section-header" role="banner"{% if section.settings.count_badge_bg != blank or section.settings.count_badge_text != blank %} style="{% if section.settings.count_badge_bg != blank %}--header-badge-bg: {{ section.settings.count_badge_bg }};{% endif %}{% if section.settings.count_badge_text != blank %} --header-badge-text: {{ section.settings.count_badge_text }};{% endif %}"{% endif %}>
  {% comment %}
    Compact mobile bar (hamburger + logo + icons + search overlay). Hidden
    on desktop via SCSS; below 992px it's the ONLY header shown — the
    .header-top, .header-middle, and .section-navigation blocks are
    display:none on mobile to keep the page under 120px of header.
  {% endcomment %}
  {% render 'header-mobile', section: section %}

  {% render 'header-top', section: section %}

  {% render 'header-middle', section: section %}
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "header_layout",
      "label": "Desktop layout",
      "options": [
        {
          "value": "classic",
          "label": "Classic (with navigation bar)"
        },
        {
          "value": "inline",
          "label": "Inline (logo, menu, icons in one row)"
        },
        {
          "value": "centered",
          "label": "Centered logo (hotline | logo | search, cart in the top bar)"
        }
      ],
      "default": "classic",
      "info": "Inline: also turn off Navigation → Show desktop bar. Mobile is the same for both."
    },
    {
      "type": "link_list",
      "id": "inline_menu",
      "label": "Menu (inline layout)",
      "default": "main-menu",
      "visible_if": "{{ section.settings.header_layout == 'inline' }}"
    },
    {
      "type": "textarea",
      "id": "menu_badges",
      "label": "Menu badges (inline layout)",
      "info": "One per line: Menu title|LABEL|#background|#text (text optional), e.g. Sale|HOT|#d64545",
      "visible_if": "{{ section.settings.header_layout == 'inline' }}"
    },
    {
      "type": "select",
      "id": "menu_badge_position",
      "label": "Menu badge position (inline layout)",
      "options": [
        {
          "value": "inline",
          "label": "Next to the menu title"
        },
        {
          "value": "above",
          "label": "Above the title, with an arrow"
        }
      ],
      "default": "inline",
      "visible_if": "{{ section.settings.header_layout == 'inline' }}"
    },
    {
      "type": "select",
      "id": "search_style",
