{%- comment -%}
  Newsletter popup — PSD 02_Homepage_Hover_Popup Newletters ("Popup Newletters"):
  1184×438 dialog over a 50% black page veil. Left (white, 591px): 30px title, 18px subtitle,
  dashed 494×43 email field with an envelope, mint 494×42 SUBMIT bar, "We promise…" line,
  47px #565656 social discs, "Do not show it anymore" checkbox. Right: image panel (yellow).
  Native Shopify customer signup. Behaviour (delay, dismiss, "don't show again") lives in
  common/js/modules/newsletter-popup.js.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign form_id = 'NewsletterPopupForm-' | append: section.id
  assign title_id = 'NewsletterPopupTitle-' | append: section.id
  assign email_id = 'NewsletterPopupEmail-' | append: section.id

  assign enabled = s.enable_popup
  if s.show_on == 'home' and template.name != 'index'
    assign enabled = false
  endif
-%}

{%- style -%}
  #NewsletterPopup-{{ section.id }} {
    --nlp-bg: {{ s.background_color }};
    --nlp-text: {{ s.text_color }};
    --nlp-media-bg: {{ s.media_bg }};
    --nlp-button: {{ s.button_color }};
    --nlp-overlay: {{ s.overlay_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}

{%- if enabled or request.design_mode -%}
  <div
    id="NewsletterPopup-{{ section.id }}"
    class="newsletter-popup{% if s.layout == 'framed' %} newsletter-popup--framed{% endif %}"
    data-newsletter-popup
    data-section-id="{{ section.id }}"
    data-form-id="{{ form_id }}"
    data-delay="{{ s.delay }}"
    data-dismiss-days="{{ s.dismiss_days }}"
    {% unless enabled %}data-disabled{% endunless %}
    hidden
  >
    <div class="newsletter-popup__overlay" data-newsletter-popup-close></div>

    <div
      class="newsletter-popup__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="{{ title_id }}"
      tabindex="-1"
    >
      <button
        type="button"
        class="newsletter-popup__close"
        data-newsletter-popup-close
        aria-label="{{ 'accessibility.close' | t }}"
      >
        {% render 'oc-icon', name: 'close' %}
      </button>

      <div class="newsletter-popup__content">
        {%- if s.title != blank -%}
          <h2 class="newsletter-popup__title" id="{{ title_id }}">{{ s.title | escape }}</h2>
        {%- endif -%}
        {%- if s.subtitle != blank -%}
          <p class="newsletter-popup__subtitle">{{ s.subtitle | escape }}</p>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="newsletter-popup__text">{{ s.text }}</div>
        {%- endif -%}

        {%- form 'customer', id: form_id, class: 'newsletter-popup__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,prospect,popup">

          {%- if form.posted_successfully? -%}
            <p class="newsletter-popup__message newsletter-popup__message--success" role="status" data-newsletter-popup-success>
              {%- if s.success_message != blank -%}
                {{ s.success_message | escape }}
              {%- else -%}
                {{ 'newsletter.success' | t }}
              {%- endif -%}
            </p>
          {%- else -%}
            <div class="newsletter-popup__field">
              <label class="visually-hidden" for="{{ email_id }}">{{ 'newsletter.label' | t }}</label>
              <input
                id="{{ email_id }}"
                class="newsletter-popup__input"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ s.placeholder | escape }}"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
                {% if form.errors %}
                  aria-invalid="true" aria-describedby="{{ form_id }}-error"
                {% endif %}
              >
              {% render 'oc-icon', name: 'envelope', class: 'newsletter-popup__field-icon' %}
            </div>
            <button type="submit" class="newsletter-popup__submit">
              {{- s.button_label | default: 'Submit' | escape -}}
            </button>

            {%- if form.errors -%}
              <p class="newsletter-popup__message newsletter-popup__message--error" id="{{ form_id }}-error" role="alert">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}

        {%- if s.promise_text != blank -%}
          <p class="newsletter-popup__promise">{{ s.promise_text | escape }}</p>
        {%- endif -%}

        {%- if s.show_social -%}
          <ul class="newsletter-popup__social list-unstyled" role="list">
            {%- if settings.social_facebook_link != blank -%}
              <li><a href="{{ settings.social_facebook_link }}" class="newsletter-popup__social-link" aria-label="{{ 'general.social.links.facebook' | t }}">{% render 'oc-icon', name: 'facebook' %}</a></li>
            {%- endif -%}
            {%- if settings.social_twitter_link != blank -%}
              <li><a href="{{ settings.social_twitter_link }}" class="newsletter-popup__social-link" aria-label="{{ 'general.social.links.twitter' | t }}">{% render 'oc-icon', name: 'twitter' %}</a></li>
            {%- endif -%}
            {%- if settings.social_pinterest_link != blank -%}
              <li><a href="{{ settings.social_pinterest_link }}" class="newsletter-popup__social-link" aria-label="{{ 'general.social.links.pinterest' | t }}">{% render 'oc-icon', name: 'pinterest' %}</a></li>
            {%- endif -%}
            {%- if settings.social_instagram_link != blank -%}
              <li><a href="{{ settings.social_instagram_link }}" class="newsletter-popup__social-link" aria-label="{{ 'general.social.links.instagram' | t }}">{% render 'oc-icon', name: 'instagram' %}</a></li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {%- if s.dont_show_label != blank -%}
          <label class="newsletter-popup__never">
            <input type="checkbox" class="newsletter-popup__never-input" data-newsletter-popup-never>
            <span>{{ s.dont_show_label | escape }}</span>
          </label>
        {%- endif -%}
      </div>

      {%- if s.layout == 'framed' -%}
        {%- comment -%} Fashion #1 PSD: cut-out photos in the bottom corners, clipped by the box {%- endcomment -%}
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 300 | image_tag: class: 'newsletter-popup__corner newsletter-popup__corner--start', loading: 'lazy', alt: '' }}
        {%- endif -%}
        {%- if s.image_2 != blank -%}
          {{ s.image_2 | image_url: width: 300 | image_tag: class: 'newsletter-popup__corner newsletter-popup__corner--end', loading: 'lazy', alt: '' }}
        {%- endif -%}
      {%- else -%}
      <div class="newsletter-popup__media">
        {%- if s.image != blank -%}
          {{
            s.image
            | image_url: width: 1200
            | image_tag:
              class: 'newsletter-popup__img',
              loading: 'lazy',
              sizes: '(min-width: 750px) 593px, 100vw',
              widths: '600, 900, 1200',
              alt: s.image.alt
          }}
        {%- else -%}
          <img
            class="newsletter-popup__img"
            src="{{ 'oc-newsletter-popup.png' | asset_url }}"
            alt=""
            width="593"
            height="438"
            loading="lazy"
          >
        {%- endif -%}
      </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Newsletter popup",
  "tag": "section",
  "class": "section-newsletter-popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_popup",
      "label": "Enable popup",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "In the theme editor the popup opens while this section is selected."
    },
    {
      "type": "select",
      "id": "show_on",
      "label": "Show on",
      "options": [
        { "value": "all", "label": "All pages" },
        { "value": "home", "label": "Home page only" }
      ],
      "default": "all"
    },
    {
      "type": "range",
      "id": "delay",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "s",
      "label": "Delay before showing",
      "default": 5
    },
    {
      "type": "range",
      "id": "dismiss_days",
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "d",
      "label": "Show again after closing",
      "info": "Days before the popup reappears for visitors who closed it. \"Don't show again\" hides it permanently.",
      "default": 7
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "split",
          "label": "Form + image panel"
        },
        {
          "value": "framed",
          "label": "Compact box, photos in the bottom corners"
        }
      ],
      "default": "split"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Form + image panel: right panel, 593 × 438 px (1186 × 876 px for retina); without an image the Occasion demo artwork is shown. Compact box: bottom-left photo, about 100 px wide."
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Second image",
      "info": "Compact box only: bottom-right photo, about 95 px wide."
    },
    {
      "type": "color",
      "id": "media_bg",
      "label": "Image panel background",
      "default": "#fcf461"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Join our mailing list"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Sign up & get 10% your first order"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "enter your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Submit"
    },
    {
      "type": "text",
      "id": "promise_text",
      "label": "Text under the button",
      "default": "We promise to only send you good things"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "info": "Links from Theme settings → Social media.",
      "default": true
    },
    {
      "type": "text",
      "id": "dont_show_label",
      "label": "\"Don't show again\" label",
      "default": "Do not show it anymore"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "#bbd8b2"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Page overlay opacity",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Newsletter popup"
    }
  ]
}
{% endschema %}
