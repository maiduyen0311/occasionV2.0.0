{%- comment -%}
  Newsletter popup — mockup design/TopMarket_Newsletter.jpg (PSD group "Newsletter").
  892×404 dialog: text + email form on the left, image on the right, round
  close button top-right. Native Shopify customer signup (SPEC §5.9).
  Submit button follows the theme's primary color (--color-primary).
  Behaviour (delay, dismiss, "don't show again") lives in
  common/js/modules/newsletter-popup.js.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign form_id = 'NewsletterPopupForm-' | append: section.id
  assign title_id = 'NewsletterPopupTitle-' | append: section.id
  assign email_id = 'NewsletterPopupEmail-' | append: section.id

  assign enabled = s.enable_popup
  if s.show_on == 'home' and template.name != 'index'
    assign enabled = false
  endif
-%}

{%- style -%}
  #NewsletterPopup-{{ section.id }} {
    --nlp-bg: {{ s.background_color }};
    --nlp-text: {{ s.text_color }};
    --nlp-overlay: {{ s.overlay_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}

{%- if enabled or request.design_mode -%}
  <div
    id="NewsletterPopup-{{ section.id }}"
    class="newsletter-popup newsletter-popup--image-{{ s.image_layout }} newsletter-popup--title-{{ s.title_font }}"
    data-newsletter-popup
    data-section-id="{{ section.id }}"
    data-form-id="{{ form_id }}"
    data-delay="{{ s.delay }}"
    data-dismiss-days="{{ s.dismiss_days }}"
    {% unless enabled %}data-disabled{% endunless %}
    hidden
  >
    <div class="newsletter-popup__overlay" data-newsletter-popup-close></div>

    <div
      class="newsletter-popup__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="{{ title_id }}"
      tabindex="-1"
    >
      <button
        type="button"
        class="newsletter-popup__close"
        data-newsletter-popup-close
        aria-label="{{ 'accessibility.close' | t }}"
      >
        {% render 'svg', name: 'close' %}
      </button>

      <div class="newsletter-popup__media">
        {%- if s.image != blank -%}
          {{
            s.image
            | image_url: width: 900
            | image_tag:
              class: 'newsletter-popup__img',
              loading: 'lazy',
              sizes: '(min-width: 750px) 450px, 100vw',
              widths: '450, 900',
              alt: s.image.alt
          }}
        {%- else -%}
          {% render 'header-mega-placeholder-image',
            class: 'newsletter-popup__img',
            width: 405,
            height: 404
          %}
        {%- endif -%}
      </div>

      <div class="newsletter-popup__content">
        {%- if s.title != blank -%}
          <h2 class="newsletter-popup__title" id="{{ title_id }}">{{ s.title | escape }}</h2>
        {%- endif -%}

        {%- if s.text != blank -%}
          <div class="newsletter-popup__text">{{ s.text }}</div>
        {%- endif -%}

        {%- form 'customer', id: form_id, class: 'newsletter-popup__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,prospect,popup">

          {%- if form.posted_successfully? -%}
            <p class="newsletter-popup__message newsletter-popup__message--success" role="status" data-newsletter-popup-success>
              {%- if s.success_message != blank -%}
                {{ s.success_message | escape }}
              {%- else -%}
                {{ 'newsletter.success' | t }}
              {%- endif -%}
            </p>
          {%- else -%}
            <div class="newsletter-popup__field">
              <label class="visually-hidden" for="{{ email_id }}">{{ 'newsletter.label' | t }}</label>
              <input
                id="{{ email_id }}"
                class="newsletter-popup__input"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ s.placeholder | escape }}"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
                {% if form.errors %}
                  aria-invalid="true" aria-describedby="{{ form_id }}-error"
                {% endif %}
              >
              <button type="submit" class="newsletter-popup__submit" aria-label="{{ 'newsletter.button_label' | t }}">
                {% render 'svg', name: 'arrow-right' %}
              </button>
            </div>

            {%- if form.errors -%}
              <p class="newsletter-popup__message newsletter-popup__message--error" id="{{ form_id }}-error" role="alert">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}

        {%- if s.dont_show_label != blank -%}
          <label class="newsletter-popup__never">
            <input type="checkbox" class="newsletter-popup__never-input" data-newsletter-popup-never>
            <span>{{ s.dont_show_label | escape }}</span>
          </label>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Newsletter popup",
  "tag": "section",
  "class": "section-newsletter-popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_popup",
      "label": "Enable popup",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "In the theme editor the popup opens while this section is selected."
    },
    {
      "type": "select",
      "id": "show_on",
      "label": "Show on",
      "options": [
        { "value": "all", "label": "All pages" },
        { "value": "home", "label": "Home page only" }
      ],
      "default": "all"
    },
    {
      "type": "range",
      "id": "delay",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "s",
      "label": "Delay before showing",
      "default": 5
    },
    {
      "type": "range",
      "id": "dismiss_days",
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "d",
      "label": "Show again after closing",
      "info": "Days before the popup reappears for visitors who closed it. \"Don't show again\" hides it permanently.",
      "default": 7
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Recommended 900 × 900 px."
    },
    {
      "type": "select",
      "id": "image_layout",
      "label": "Image layout",
      "options": [
        { "value": "right", "label": "Right side" },
        { "value": "cover", "label": "Full background" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Newsletter Sign Up"
    },
    {
      "type": "select",
      "id": "title_font",
      "label": "Title font",
      "info": "Uses the fonts from Theme settings → Top Market — Typography.",
      "options": [
        { "value": "script", "label": "Script font" },
        { "value": "heading", "label": "Heading font" }
      ],
      "default": "script"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Enter your email below to receive a $30 coupon, special offers, exclusive discounts and more!</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "dont_show_label",
      "label": "\"Don't show again\" label",
      "default": "Don't Show This Popup Again"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#e5d8cf"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Page overlay opacity",
      "default": 40
    },
    {
      "type": "paragraph",
      "content": "Submit button uses the theme primary color (Theme settings → Top Market — Colors)."
    }
  ],
  "presets": [
    {
      "name": "Newsletter popup"
    }
  ]
}
{% endschema %}
