{%- comment -%}
  Password page header — logo (left) + "Enter using password" dropdown
  (native <details>, no JS). Styles: _password.scss.
{%- endcomment -%}
<header class="tm-password-header">
  <div class="container d-flex align-items-center justify-content-between gap-3">
    <a href="{{ routes.root_url }}" class="tm-password-header__logo">
      {%- if settings.logo != blank -%}
        {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
        {{
          settings.logo
          | image_url: width: 400
          | image_tag: widths: '150, 200, 300, 400', width: section.settings.logo_width, alt: logo_alt
        }}
      {%- else -%}
        <span class="tm-password-header__name">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <details class="tm-password-login" data-password-login>
      <summary class="tm-btn tm-btn--outline tm-btn--sm">
        {% render 'icon-padlock' %}
        {{ 'general.password_page.login_password_button' | t }}
      </summary>
      <div class="tm-password-login__panel" role="dialog" aria-labelledby="PasswordDialogHeading">
        <h2 class="tm-password-login__heading" id="PasswordDialogHeading">{{ 'general.password_page.login_form_heading' | t }}</h2>
        {%- form 'storefront_password', class: 'tm-password-login__form' -%}
          <label class="visually-hidden" for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
          <input
            type="password"
            name="password"
            id="Password"
            class="tm-input"
            autocomplete="current-password"
            placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="PasswordLoginForm-password-error"
            {% endif %}
          >
          {%- if form.errors -%}
            <script>document.currentScript.closest('details').open = true;</script>
            <small id="PasswordLoginForm-password-error" class="tm-field-error" role="status">
              {{ 'general.password_page.login_form_error' | t }}
            </small>
          {%- endif -%}
          <button name="commit" class="tm-btn tm-btn--block mt-3">{{ 'general.password_page.login_form_submit' | t }}</button>
        {%- endform -%}
        <small class="tm-password-login__admin">{{ 'general.password_page.admin_link_html' | t }}</small>
      </div>
    </details>
  </div>
</header>

{% schema %}
{
  "name": "t:sections.main-password-header.name",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-password-header.settings.logo_help.content"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 180
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
