
{%- if section.settings.show_color_swatches -%}
{%- endif -%}

{% if section.settings.image_shape == 'blob' %}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  #HomeBestSelling-{{ section.id }} {
    --best-selling-accent: {{ section.settings.accent_color }};
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign products_limit = section.settings.products_to_show
  assign first_block = section.blocks | first
  assign first_collection_url = ''
  if first_block != blank and first_block.settings.collection != blank
    assign first_collection_url = first_block.settings.collection.url
  endif
-%}

<section
  id="HomeBestSelling-{{ section.id }}"
  class="home-best-selling best-selling-tabs home-best-selling--header-{{ section.settings.header_layout | default: 'split' }} home-best-selling--tabs-{{ section.settings.tabs_style | default: 'text' }} section-{{ section.id }} section-{{ section.id }}-padding section-home-best-selling color-{{ section.settings.color_scheme }} isolate gradient"
  data-section-id="{{ section.id }}"
>
  <div class="{% if section.settings.full_width %}container-fluid{% else %}container{% endif %}">
    <div class="home-best-selling__inner" data-tabs-root>
      <header class="home-best-selling__header">
        <div class="home-best-selling__heading">
          {%- if section.settings.eyebrow != blank -%}
            <p class="home-best-selling__eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h2 class="home-best-selling__title">{{ section.settings.title }}</h2>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <ul class="home-best-selling__tabs tm-acc-nav" role="tablist">
            {%- for block in section.blocks -%}
              {%- liquid
                assign tab_label = block.settings.tab_label
                if tab_label == blank and block.settings.collection != blank
                  assign tab_label = block.settings.collection.title
                endif
                if tab_label == blank
                  assign tab_label = 'Tab ' | append: forloop.index
                endif
                assign tab_collection_url = ''
                if block.settings.collection != blank
                  assign tab_collection_url = block.settings.collection.url
                endif
              -%}
              <li
                class="home-best-selling__tab-item{% if forloop.first %} is-active active{% endif %}"
                role="presentation"
                {{ block.shopify_attributes }}
              >
                <button
                  type="button"
                  class="home-best-selling__tab"
                  role="tab"
                  data-toggle="tab"
                  data-tab="{{ block.id }}"
                  data-collection-url="{{ tab_collection_url }}"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-controls="BestSellingPanel-{{ section.id }}-{{ block.id }}"
                  id="BestSellingTab-{{ section.id }}-{{ block.id }}"
                >
                  {{ tab_label | escape }}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </header>

      {%- if section.blocks.size > 0 -%}
        <div class="home-best-selling__panels">
          {%- for block in section.blocks -%}
            {%- liquid
              assign tab_collection = block.settings.collection
              assign tab_label = block.settings.tab_label
              if tab_label == blank and tab_collection != blank
                assign tab_label = tab_collection.title
              endif
              if tab_label == blank
                assign tab_label = 'Tab ' | append: forloop.index
              endif
            -%}
            <div
              id="BestSellingPanel-{{ section.id }}-{{ block.id }}"
              class="tabs__pane home-best-selling__panel tm-acc-item{% if forloop.first %} is-active show is-open{% endif %}"
              role="tabpanel"
              data-id="{{ block.id }}"
              data-acc-item
              aria-labelledby="BestSellingTab-{{ section.id }}-{{ block.id }}"
            >
              {%- comment -%} Accordion header — phones only (tab bar hidden there) {%- endcomment -%}
              <button
                type="button"
                class="tm-acc-toggle"
                data-acc-toggle
                aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="BestSellingBody-{{ section.id }}-{{ block.id }}"
              >
                {{ tab_label | escape }}
                <span class="tm-acc-icon" aria-hidden="true"></span>
              </button>
              <div
                id="BestSellingBody-{{ section.id }}-{{ block.id }}"
                class="collection home-best-selling__collection tm-acc-body{% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}"
              >
                <ul
                  class="grid product-grid contains-card contains-card--product{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down"
                  role="list"
                >
                  {% assign skip_card_product_styles = false %}
                  {%- if tab_collection != blank -%}
                    {%- for product in tab_collection.products limit: products_limit -%}
                      <li
                        id="BestSelling-{{ section.id }}-{{ block.id }}-{{ forloop.index }}"
                        class="grid__item"
                      >
                        {% render 'card-product',
                          card_product: product,
                          media_aspect_ratio: section.settings.image_ratio,
                          image_shape: section.settings.image_shape,
                          show_secondary_image: section.settings.show_secondary_image,
                          show_vendor: section.settings.show_vendor,
                          show_rating: section.settings.show_rating,
                          show_rating_placeholder: section.settings.show_rating,
                          show_discount_badge: section.settings.show_discount_badge,
                          show_color_swatches: section.settings.show_color_swatches,
                          skip_styles: skip_card_product_styles,
                          section_id: section.id,
                          quick_add: section.settings.quick_add
                        %}
                      </li>
                      {%- assign skip_card_product_styles = true -%}
                    {%- endfor -%}
                  {%- else -%}
                    {%- for i in (1..section.settings.columns_desktop) -%}
                      <li class="grid__item">
                        {% liquid
                          assign ridx = forloop.rindex
                          case ridx
                            when 5
                              assign ridx = 1
                            when 6
                              assign ridx = 2
                          endcase
                        %}
                        {%- assign placeholder_image = 'product-apparel-' | append: ridx -%}
                        {% render 'card-product',
                          show_vendor: section.settings.show_vendor,
                          media_aspect_ratio: section.settings.image_ratio,
                          image_shape: section.settings.image_shape,
                          placeholder_image: placeholder_image
                        %}
                      </li>
                    {%- endfor -%}
                  {%- endif -%}
                </ul>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.show_view_all -%}
          <div class="home-best-selling__footer">
            <a
              href="{{ first_collection_url }}"
              class="home-best-selling__view-all"
              data-best-selling-view-all
            >
              {{ section.settings.view_all_label }}
            </a>
          </div>
        {%- endif -%}
      {%- else -%}
        {%- if request.design_mode -%}<p class="home-best-selling__empty">Add collection tabs in section settings.</p>{%- endif -%}
      {%- endif -%}

      {% if section.settings.image_shape == 'arch' %}
        {% render 'mask-arch' %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home best selling",
  "tag": "section",
  "class": "section-home-best-selling",
  "max_blocks": 8,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FUTURE PRODUCT"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Top Best Selling Products"
    },
    {
      "type": "select",
      "id": "header_layout",
      "label": "Heading layout",
      "options": [
        {
          "value": "split",
          "label": "Heading left, tabs right"
        },
        {
          "value": "center",
          "label": "Centered, tabs below the heading"
        }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "tabs_style",
      "label": "Tab style",
      "options": [
        {
          "value": "text",
          "label": "Text"
        },
        {
          "value": "buttons",
          "label": "Buttons"
        }
      ],
      "default": "text"
    },
    {
      "type": "header",
      "content": "Tabs"
    },
    {
      "type": "paragraph",
      "content": "Add blocks below — each block is one tab linked to a collection."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 20,
      "step": 1,
      "label": "Products per tab",
      "default": 10
    },
    {
      "type": "header",
      "content": "Product grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 5
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "arch",
          "label": "Arch"
        },
        {
          "value": "blob",
          "label": "Blob"
        },
        {
          "value": "round",
          "label": "Round"
        }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product rating",
      "default": true,
      "info": "Shows review rating when available, otherwise 5 placeholder stars."
    },
    {
      "type": "checkbox",
      "id": "show_discount_badge",
      "label": "Show discount badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_color_swatches",
      "label": "Show color swatches",
      "default": true
    },
    {
      "type": "select",
      "id": "quick_add",
      "label": "Quick add",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "bulk",
          "label": "Bulk"
        }
      ]
    },
    {
      "type": "header",
      "content": "View all button"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button label",
      "default": "+ SEE ALL PRODUCTS"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (active tab & sale price)",
      "default": "#dc5414"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "Collection tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab label",
          "info": "Leave blank to use collection title"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home best selling",
      "blocks": [
        {
          "type": "collection_tab",
          "settings": {
            "tab_label": "All"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "tab_label": "Clothing"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "tab_label": "Shoe"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "tab_label": "Bag"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "tab_label": "Watch"
          }
        }
      ]
    }
  ]
}
{% endschema %}
