{% comment %}
  Wishlist page — saved handles live in localStorage (`occasion:wishlist`,
  common/js/modules/wishlist.js). common/js/modules/wishlist-page.js hydrates:
    • Table view: image, title, variant picker, price, stock, date added, Add to cart
    • Grid view: real card-product markup from /products/<handle>?view=card
    • Share: ?items=h1,h2 link — visitors see the shared list + "Save to my wishlist"
  Styles: common/scss/section/_wishlist-page.scss
{% endcomment %}
{%- style -%}
  #WishlistPage-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- if section.settings.show_breadcrumb -%}
  {%- assign crumb = section.settings.heading | escape -%}
  {% render 'page-breadcrumb', current: crumb %}
{%- endif -%}

<section
  id="WishlistPage-{{ section.id }}"
  class="wishlist-page"
  data-wishlist-page
  data-default-view="{{ section.settings.default_view }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-currency="{{ cart.currency.iso_code }}"
  data-root-url="{{ routes.root_url }}"
  data-label-in-stock="{{ section.settings.in_stock_label | escape }}"
  data-label-out-stock="{{ section.settings.out_stock_label | escape }}"
  data-label-add="{{ 'products.product.add_to_cart' | t }}"
  data-label-sold-out="{{ 'products.product.sold_out' | t }}"
  data-label-remove="{{ section.settings.remove_label | escape }}"
  data-label-added-on="{{ section.settings.added_on_label | escape }}"
  data-label-copied="{{ section.settings.copied_label | escape }}"
>
  <div class="container">
    <header class="wishlist-page__header">
      <div>
        <h1 class="wishlist-page__title">
          <span data-wishlist-title>{{ section.settings.heading }}</span>
          <span class="wishlist-page__count">(<span data-wishlist-count-text>0</span>)</span>
        </h1>
        <p class="wishlist-page__subtitle" data-wishlist-subtitle>{{ section.settings.subtitle }}</p>
        <p class="wishlist-page__subtitle wishlist-page__subtitle--shared" data-wishlist-shared-note hidden>{{ section.settings.shared_text }}</p>
      </div>

      <div class="wishlist-page__toolbar" data-wishlist-toolbar hidden>
        <div class="wishlist-page__views" role="group" aria-label="{{ section.settings.view_label | escape }}">
          <button type="button" class="wishlist-page__view" data-wishlist-view="table" aria-label="{{ section.settings.table_view_label | escape }}" title="{{ section.settings.table_view_label | escape }}">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><circle cx="2" cy="3" r="1.5"/><circle cx="2" cy="8" r="1.5"/><circle cx="2" cy="13" r="1.5"/><rect x="5" y="2.3" width="11" height="1.4"/><rect x="5" y="7.3" width="11" height="1.4"/><rect x="5" y="12.3" width="11" height="1.4"/></svg>
          </button>
          <button type="button" class="wishlist-page__view" data-wishlist-view="grid" aria-label="{{ section.settings.grid_view_label | escape }}" title="{{ section.settings.grid_view_label | escape }}">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><rect x="1" y="1" width="6" height="6" rx="1"/><rect x="9" y="1" width="6" height="6" rx="1"/><rect x="1" y="9" width="6" height="6" rx="1"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg>
          </button>
        </div>
        {%- if section.settings.show_share -%}
          <button type="button" class="wishlist-page__tool" data-wishlist-share>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="18" cy="5" r="2.6"/><circle cx="6" cy="12" r="2.6"/><circle cx="18" cy="19" r="2.6"/><path d="m8.3 10.8 7.4-4.4M8.3 13.2l7.4 4.4"/></svg>
            <span>{{ section.settings.share_label }}</span>
          </button>
        {%- endif -%}
        <button type="button" class="wishlist-page__tool" data-wishlist-clear>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg>
          <span>{{ section.settings.clear_label }}</span>
        </button>
        <button type="button" class="tm-btn tm-btn--sm" data-wishlist-add-all>{{ section.settings.add_all_label }}</button>
        <button type="button" class="tm-btn tm-btn--sm" data-wishlist-save-shared hidden>{{ section.settings.save_shared_label }}</button>
      </div>
    </header>

    {%- comment -%} Table view (Bootstrap grid rows) {%- endcomment -%}
    <div class="wishlist-page__table" data-wishlist-table hidden>
      <div class="row wishlist-page__head d-none d-lg-flex" role="presentation">
        <div class="col-lg-5">{{ section.settings.col_product }}</div>
        <div class="col-lg-2">{{ section.settings.col_price }}</div>
        <div class="col-lg-2">{{ section.settings.col_stock }}</div>
        <div class="col-lg-3 text-lg-end">{{ section.settings.col_action }}</div>
      </div>
      <ul class="wishlist-page__rows list-unstyled m-0" role="list" data-wishlist-rows></ul>
    </div>

    {%- comment -%} Grid view (card-product via ?view=card) {%- endcomment -%}
    <ul
      class="row row-cols-2 row-cols-md-3 row-cols-lg-{{ section.settings.columns_desktop }} g-4 list-unstyled wishlist-page__grid"
      role="list"
      data-wishlist-grid
      hidden
    ></ul>

    <div class="wishlist-page__skeleton" data-wishlist-loading hidden aria-live="polite">
      {%- for i in (1..3) -%}
        <div class="wishlist-page__skeleton-row"><span></span><span></span><span></span></div>
      {%- endfor -%}
      <span class="visually-hidden">{{ section.settings.loading_text }}</span>
    </div>

    <p class="tm-alert tm-alert--error" data-wishlist-error hidden role="alert">{{ section.settings.error_text }}</p>

    <div class="wishlist-page__empty" data-wishlist-empty hidden>
      <div class="wishlist-page__empty-icon" aria-hidden="true">
        {% render 'icon-heart' %}
      </div>
      <h2 class="wishlist-page__empty-heading">{{ section.settings.empty_heading }}</h2>
      <p class="wishlist-page__empty-text">{{ section.settings.empty_text }}</p>
      <a href="{{ section.settings.empty_cta_url | default: routes.all_products_collection_url }}" class="tm-btn">{{ section.settings.empty_cta }}</a>
    </div>

    {%- if section.settings.show_benefits -%}
      <ul class="row row-cols-1 row-cols-md-3 g-3 list-unstyled wishlist-page__benefits">
        <li class="col"><div><strong>{{ section.settings.benefit_1_title }}</strong><span>{{ section.settings.benefit_1_text }}</span></div></li>
        <li class="col"><div><strong>{{ section.settings.benefit_2_title }}</strong><span>{{ section.settings.benefit_2_text }}</span></div></li>
        <li class="col"><div><strong>{{ section.settings.benefit_3_title }}</strong><span>{{ section.settings.benefit_3_text }}</span></div></li>
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
