{% comment %}
  Occasion — Product detail tabs (Description / Reviews / Size & Fit / Shipping / Custom)
  Each tab is a block. Active tab marked with a dark underline.
  Reviews tab: rating summary (product metafields reviews.rating / rating_count,
  falls back to block settings) + star breakdown + 3 sample reviews.
  Size & Fit tab: intro + size chart (HTML table setting) + how-to-measure.
{% endcomment %}
{%- style -%}
  #ProductTabs-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section id="ProductTabs-{{ section.id }}" class="product-tabs" data-product-tabs-root>
  <div class="container">
    {%- if section.blocks.size > 0 -%}
      <div class="product-tabs__nav tm-acc-nav" role="tablist">
        {%- for block in section.blocks -%}
          <button
            type="button"
            role="tab"
            class="product-tabs__tab{% if forloop.first %} is-active{% endif %}"
            data-tab-target="tab-{{ section.id }}-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="tab-{{ section.id }}-{{ block.id }}"
            id="tab-trigger-{{ section.id }}-{{ block.id }}"
          >
            {{ block.settings.heading }}
          </button>
        {%- endfor -%}
      </div>
      <div class="product-tabs__panels">
        {%- for block in section.blocks -%}
          <div
            role="tabpanel"
            class="product-tabs__panel tm-acc-item{% if forloop.first %} is-active is-open{% endif %}"
            id="tab-{{ section.id }}-{{ block.id }}"
            aria-labelledby="tab-trigger-{{ section.id }}-{{ block.id }}"
            data-acc-item
            {{ block.shopify_attributes }}
          >
            {%- comment -%} Accordion header — phones only (tab bar hidden there) {%- endcomment -%}
            <button
              type="button"
              class="tm-acc-toggle"
              data-acc-toggle
              aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="tab-body-{{ section.id }}-{{ block.id }}"
            >
              {{ block.settings.heading }}
              <span class="tm-acc-icon" aria-hidden="true"></span>
            </button>
            <div class="tm-acc-body" id="tab-body-{{ section.id }}-{{ block.id }}">
            {%- case block.type -%}
              {%- when 'description' -%}
                <div class="product-tabs__body rte">
                  {%- if block.settings.use_product_description and product.description != blank -%}
                    {%- if product.description contains '[des]' -%}{{ product.description | split: '[des]' | first }}{{ product.description | split: '[/des]' | last }}{%- else -%}{{ product.description }}{%- endif -%}
                  {%- else -%}
                    {{ block.settings.content }}
                  {%- endif -%}
                </div>

              {%- when 'reviews' -%}
                {%- liquid
                  assign r_value = product.metafields.reviews.rating.value.rating | default: block.settings.fallback_rating
                  assign r_scale = product.metafields.reviews.rating.value.scale_max | default: 5
                  assign r_count = product.metafields.reviews.rating_count | default: block.settings.fallback_count
                  assign r_pct = r_value | times: 100.0 | divided_by: r_scale
                  assign bars = block.settings.breakdown | split: ','
                -%}
                <div class="product-tabs__body product-reviews-tab">
                  <div class="row g-4 g-lg-5">
                    <div class="col-12 col-lg-4">
                      <div class="product-reviews-tab__summary">
                        <p class="product-reviews-tab__score">{{ r_value | round: 1 }}<span>/ {{ r_scale }}</span></p>
                        <span class="product-reviews-tab__stars" style="--pct: {{ r_pct }}%;" aria-label="{{ r_value | round: 1 }} / {{ r_scale }}"></span>
                        <p class="product-reviews-tab__count">{{ block.settings.count_label | replace: '[count]', r_count }}</p>
                        <ul class="product-reviews-tab__bars list-unstyled">
                          {%- for star in (1..5) reversed -%}
                            {%- assign i = 5 | minus: star -%}
                            {%- assign pct = bars[i] | strip | default: 0 -%}
                            <li>
                              <span>{{ star }} ★</span>
                              <span class="product-reviews-tab__bar"><span style="width: {{ pct }}%;"></span></span>
                              <span>{{ pct }}%</span>
                            </li>
                          {%- endfor -%}
                        </ul>
                        {%- if block.settings.button_label != blank -%}
                          <a href="{{ block.settings.button_url | default: '#' }}" class="tm-btn tm-btn--dark tm-btn--block">{{ block.settings.button_label }}</a>
                        {%- endif -%}
                      </div>
                    </div>
                    <div class="col-12 col-lg-8">
                      {%- if block.settings.content != blank -%}
                        <div class="rte product-reviews-tab__intro">{{ block.settings.content }}</div>
                      {%- endif -%}
                      <ul class="product-reviews-tab__list list-unstyled">
                        {%- for n in (1..3) -%}
                          {%- assign k_author = 'review_' | append: n | append: '_author' -%}
                          {%- assign k_meta = 'review_' | append: n | append: '_meta' -%}
                          {%- assign k_rating = 'review_' | append: n | append: '_rating' -%}
                          {%- assign k_title = 'review_' | append: n | append: '_title' -%}
                          {%- assign k_text = 'review_' | append: n | append: '_text' -%}
                          {%- if block.settings[k_author] != blank -%}
                            {%- assign rv_pct = block.settings[k_rating] | times: 20 -%}
                            <li class="product-reviews-tab__item">
                              <div class="d-flex align-items-center gap-3">
                                <span class="product-reviews-tab__avatar" aria-hidden="true">{{ block.settings[k_author] | slice: 0 }}</span>
                                <div>
                                  <p class="product-reviews-tab__author">{{ block.settings[k_author] | escape }}</p>
                                  <p class="product-reviews-tab__meta">{{ block.settings[k_meta] | escape }}</p>
                                </div>
                                <span class="product-reviews-tab__stars product-reviews-tab__stars--sm ms-auto" style="--pct: {{ rv_pct }}%;" aria-label="{{ block.settings[k_rating] }} / 5"></span>
                              </div>
                              <p class="product-reviews-tab__title">{{ block.settings[k_title] | escape }}</p>
                              <p class="product-reviews-tab__text">{{ block.settings[k_text] | escape }}</p>
                            </li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                    </div>
                  </div>
                </div>

              {%- when 'size_fit' -%}
                <div class="product-tabs__body">
                  <div class="row g-4 g-lg-5">
                    <div class="col-12 col-lg-7">
                      {%- if block.settings.content != blank -%}
                        <div class="rte">{{ block.settings.content }}</div>
                      {%- endif -%}
                      {%- if block.settings.size_table != blank -%}
                        <div class="product-tabs__table-wrap">{{ block.settings.size_table }}</div>
                      {%- endif -%}
                    </div>
                    <div class="col-12 col-lg-5">
                      {%- if block.settings.measure_heading != blank or block.settings.measure_text != blank -%}
                        <div class="product-tabs__aside">
                          <h3>{{ block.settings.measure_heading }}</h3>
                          <div class="rte">{{ block.settings.measure_text }}</div>
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>

              {%- when 'shipping_return' or 'custom' -%}
                <div class="product-tabs__body">
                  <div class="row g-4 g-lg-5">
                    <div class="col-12{% if block.settings.content_2 != blank %} col-lg-6{% endif %} rte">{{ block.settings.content }}</div>
                    {%- if block.settings.content_2 != blank -%}
                      <div class="col-12 col-lg-6 rte">{{ block.settings.content_2 }}</div>
                    {%- endif -%}
                  </div>
                </div>
            {%- endcase -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
<script src="{{ 'product-tabs.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product tabs",
  "tag": "section",
  "class": "section product-tabs-section",
  "settings": [
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 36,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Tab heading",
          "default": "DESCRIPTION"
        },
        {
          "type": "checkbox",
          "id": "use_product_description",
          "label": "Use product description",
          "default": true
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Custom content (when above is off or the product has no description)"
        }
      ]
    },
    {
      "type": "reviews",
      "name": "Reviews",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Tab heading",
          "default": "REVIEWS"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Intro",
          "default": "<p>Real reviews from verified buyers. Every review is checked by our team before it is published.</p>"
        },
        {
          "type": "header",
          "content": "Summary"
        },
        {
          "type": "paragraph",
          "content": "Rating and count come from the product metafields reviews.rating / reviews.rating_count (set by review apps). The values below are used when a product has none."
        },
        {
          "type": "text",
          "id": "fallback_rating",
          "label": "Fallback rating",
          "default": "4.6"
        },
        {
          "type": "text",
          "id": "fallback_count",
          "label": "Fallback review count",
          "default": "24"
        },
        {
          "type": "text",
          "id": "count_label",
          "label": "Count label",
          "default": "Based on [count] reviews",
          "info": "[count] is replaced by the number of reviews."
        },
        {
          "type": "text",
          "id": "breakdown",
          "label": "Star breakdown % (5★ → 1★)",
          "default": "72, 18, 6, 3, 1"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Write a review"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        },
        {
          "type": "header",
          "content": "Review 1"
        },
        {
          "type": "text",
          "id": "review_1_author",
          "label": "Author",
          "default": "Sarah J."
        },
        {
          "type": "text",
          "id": "review_1_meta",
          "label": "Meta (date / location)",
          "default": "Verified buyer · March 12, 2026"
        },
        {
          "type": "range",
          "id": "review_1_rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "review_1_title",
          "label": "Title",
          "default": "Exactly as pictured"
        },
        {
          "type": "textarea",
          "id": "review_1_text",
          "label": "Text",
          "default": "The quality is fantastic and the colour is exactly like the photos. It arrived two days after ordering and was beautifully packaged. I have already had several compliments!"
        },
        {
          "type": "header",
          "content": "Review 2"
        },
        {
          "type": "text",
          "id": "review_2_author",
          "label": "Author",
          "default": "Michael T."
        },
        {
          "type": "text",
          "id": "review_2_meta",
          "label": "Meta (date / location)",
          "default": "Verified buyer · February 28, 2026"
        },
        {
          "type": "range",
          "id": "review_2_rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 4
        },
        {
          "type": "text",
          "id": "review_2_title",
          "label": "Title",
          "default": "Great value for money"
        },
        {
          "type": "textarea",
          "id": "review_2_text",
          "label": "Text",
          "default": "Comfortable, well made and it goes with almost everything in my wardrobe. I sized up as recommended in the size guide and the fit is perfect. Would buy again in another colour."
        },
        {
          "type": "header",
          "content": "Review 3"
        },
        {
          "type": "text",
          "id": "review_3_author",
          "label": "Author",
          "default": "Linh P."
        },
        {
          "type": "text",
          "id": "review_3_meta",
          "label": "Meta (date / location)",
          "default": "Verified buyer · January 16, 2026"
        },
        {
          "type": "range",
          "id": "review_3_rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "review_3_title",
          "label": "Title",
          "default": "My new favourite"
        },
        {
          "type": "textarea",
          "id": "review_3_text",
          "label": "Text",
          "default": "I was hesitant to order online but the support team answered all my questions quickly. The material feels premium and it still looks brand new after weeks of daily use."
        }
      ]
    },
    {
      "type": "size_fit",
      "name": "Size & Fit",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Tab heading",
          "default": "SIZE & FIT"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Intro",
          "default": "<p>Our pieces are designed with a <strong>regular, true-to-size fit</strong>. If you are between sizes or prefer a relaxed look, we recommend choosing the next size up. Measurements below are body measurements in centimetres.</p>"
        },
        {
          "type": "html",
          "id": "size_table",
          "label": "Size chart (HTML table)",
          "default": "<table class=\"tm-size-table\"><thead><tr><th>Size</th><th>XS</th><th>S</th><th>M</th><th>L</th><th>XL</th><th>2XL</th></tr></thead><tbody><tr><th>Bust</th><td>80–84</td><td>84–88</td><td>88–92</td><td>92–98</td><td>98–104</td><td>104–110</td></tr><tr><th>Waist</th><td>62–66</td><td>66–70</td><td>70–74</td><td>74–80</td><td>80–86</td><td>86–92</td></tr><tr><th>Hips</th><td>86–90</td><td>90–94</td><td>94–98</td><td>98–104</td><td>104–110</td><td>110–116</td></tr><tr><th>EU shoe</th><td>35–36</td><td>37</td><td>38</td><td>39–40</td><td>41–42</td><td>43–44</td></tr></tbody></table>"
        },
        {
          "type": "text",
          "id": "measure_heading",
          "label": "How-to-measure heading",
          "default": "How to measure"
        },
        {
          "type": "richtext",
          "id": "measure_text",
          "label": "How-to-measure text",
          "default": "<p><strong>Bust</strong> — measure around the fullest part of your chest, keeping the tape level.</p><p><strong>Waist</strong> — measure around your natural waistline, the narrowest part of your torso.</p><p><strong>Hips</strong> — stand with feet together and measure around the fullest part of your hips.</p><p><strong>Feet</strong> — measure from heel to the tip of your longest toe and compare with the EU size.</p>"
        }
      ]
    },
    {
      "type": "shipping_return",
      "name": "Shipping & Return",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Tab heading",
          "default": "SHIPPING & RETURN"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Left column",
          "default": "<p><strong>Shipping</strong></p><ul><li>Free standard shipping on all orders over $75</li><li>Standard delivery: 3–5 business days ($5.99)</li><li>Express delivery: 1–2 business days ($14.99)</li><li>International shipping to 120+ countries: 7–14 business days</li></ul><p>Orders placed before 2 pm (EST) on business days ship the same day. You will receive a tracking number by email as soon as your parcel leaves our warehouse.</p>"
        },
        {
          "type": "richtext",
          "id": "content_2",
          "label": "Right column",
          "default": "<p><strong>Returns &amp; exchanges</strong></p><ul><li>Easy returns within 15 days of delivery</li><li>Items must be unworn, unwashed and with original tags</li><li>Free exchanges for a different size or colour</li><li>Refunds are issued to the original payment method within 5–7 days</li></ul><p>To start a return, log in to your account and select the order, or contact our support team with your order number.</p>"
        }
      ]
    },
    {
      "type": "custom",
      "name": "Custom tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Tab heading",
          "default": "CUSTOM TAB"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Left column",
          "default": "<p><strong>Why shop with Occasion?</strong></p><p>We work directly with independent designers and trusted manufacturers, so you get quality products at fair prices. Every item is checked by hand before it is packed.</p><ul><li>100% authentic products</li><li>Secure checkout with SSL encryption</li><li>Support team available 7 days a week</li></ul>"
        },
        {
          "type": "richtext",
          "id": "content_2",
          "label": "Right column",
          "default": "<p><strong>Care guide</strong></p><ul><li>Follow the care label on each product</li><li>Wash dark colours separately the first few times</li><li>Store bags and shoes stuffed, away from direct sunlight</li><li>Use a soft, dry cloth to clean metal hardware</li></ul><p>Need more tips? Our blog has step-by-step care guides for every material.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product tabs",
      "blocks": [
        {
          "type": "description"
        },
        {
          "type": "reviews"
        },
        {
          "type": "size_fit"
        },
        {
          "type": "shipping_return"
        },
        {
          "type": "custom"
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
