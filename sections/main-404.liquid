{%- comment -%}
  404 — big code, message, search, CTA buttons, optional product row
  (Bootstrap row-cols + card-product). Styles: .tm-404 in _pages.scss.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign crumb = 'templates.404.title' | t -%}
{% render 'page-breadcrumb', current: crumb %}

<div class="container tm-page tm-404 section-{{ section.id }}-padding">
  <div class="row justify-content-center text-center">
    <div class="col-12 col-md-10 col-lg-7">
      <p class="tm-404__code" aria-hidden="true">{{ 'templates.404.subtext' | t }}</p>
      <h1 class="tm-page__title">{{ section.settings.heading | default: crumb }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="tm-page__subtitle rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.show_search -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="tm-search__form mb-4">
          <label class="visually-hidden" for="Search404-{{ section.id }}">{{ 'general.search.search' | t }}</label>
          <input class="tm-input" id="Search404-{{ section.id }}" type="search" name="q" placeholder="{{ 'general.search.search' | t }}…">
          <input name="options[prefix]" type="hidden" value="last">
          <button type="submit" class="tm-btn">{{ 'general.search.search' | t }}</button>
        </form>
      {%- endif -%}

      <div class="d-flex flex-wrap justify-content-center gap-3">
        <a href="{{ routes.root_url }}" class="tm-btn tm-btn--dark">{{ section.settings.home_label }}</a>
        <a href="{{ routes.all_products_collection_url }}" class="tm-btn tm-btn--outline">{{ 'general.continue_shopping' | t }}</a>
      </div>
    </div>
  </div>

  {%- assign featured = section.settings.collection -%}
  {%- if featured != blank and featured.products.size > 0 -%}
    <section class="tm-404__products">
      <h2 class="tm-page__title text-center">{{ section.settings.products_heading }}</h2>
      <ul class="row row-cols-2 row-cols-md-3 row-cols-lg-{{ section.settings.products_to_show }} g-4 list-unstyled" role="list">
        {%- for product in featured.products limit: section.settings.products_to_show -%}
          <li class="col">
            {% render 'card-product',
              card_product: product,
              show_discount_badge: true,
              show_color_swatches: true,
              show_wishlist: true,
              quick_add: 'none',
              section_id: section.id,
              lazy_load: true
            %}
          </li>
        {%- endfor -%}
      </ul>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "404 page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page not found"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Sorry, the page you are looking for doesn't exist or has been moved. Try searching or head back home.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home button label",
      "default": "Back to home"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "products_heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ]
}
{% endschema %}
