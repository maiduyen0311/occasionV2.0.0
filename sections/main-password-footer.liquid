{%- comment -%}
  Password page footer — social links + "powered by Shopify". Styles: _password.scss.
{%- endcomment -%}
<footer class="tm-password-footer">
  <div class="container d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
    <ul class="tm-password-footer__social list-unstyled d-flex gap-2 m-0" role="list">
      {%- liquid
        assign socials = 'facebook,twitter,instagram,pinterest,tiktok,youtube' | split: ','
      -%}
      {%- for s in socials -%}
        {%- assign key = 'social_' | append: s | append: '_link' -%}
        {%- if settings[key] != blank -%}
          <li>
            <a href="{{ settings[key] }}" target="_blank" rel="noopener" aria-label="{{ s | capitalize }}">
              {%- case s -%}
                {%- when 'facebook' -%}{% render 'icon-facebook' %}
                {%- when 'twitter' -%}{% render 'icon-twitter' %}
                {%- when 'instagram' -%}{% render 'icon-instagram' %}
                {%- when 'pinterest' -%}{% render 'icon-pinterest' %}
                {%- when 'tiktok' -%}{% render 'icon-tiktok' %}
                {%- when 'youtube' -%}{% render 'icon-youtube' %}
              {%- endcase -%}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    <p class="tm-password-footer__powered m-0">
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }} ·
      {% capture shopify %}<a href="https://www.shopify.com" target="_blank" rel="nofollow noopener">Shopify</a>{% endcapture %}
      {{ 'general.password_page.powered_by_shopify_html' | t: shopify: shopify }}
    </p>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.main-password-footer.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
