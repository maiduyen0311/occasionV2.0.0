{% comment %}
  FAQ accordion — native <details>/<summary>, optional "only one open at a time".
  Outputs FAQPage structured-data JSON-LD when enabled.
{% endcomment %}

<section
  id="Faq-{{ section.id }}"
  class="faq-section section-{{ section.id }} color-{{ section.settings.color_scheme }}"
  style="--faq-pt:{{ section.settings.padding_top }}px;--faq-pb:{{ section.settings.padding_bottom }}px;"
  data-faq-root
  data-single-open="{{ section.settings.single_open }}"
>
  <div class="container faq-section__container">
    <header class="faq-section__header">
      {%- if section.settings.eyebrow != blank -%}<p class="faq-section__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="faq-section__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="faq-section__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
    </header>

    <div class="faq-section__list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'question' -%}
          <details class="faq-section__item" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="faq-section__question">
              <span>{{ block.settings.question }}</span>
              <span class="faq-section__indicator" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </span>
            </summary>
            <div class="faq-section__answer rte">
              {{ block.settings.answer }}
            </div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.footer_text != blank or section.settings.cta_label != blank -%}
      <footer class="faq-section__footer">
        {%- if section.settings.footer_text != blank -%}<p>{{ section.settings.footer_text }}</p>{%- endif -%}
        {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
          <a href="{{ section.settings.cta_url }}" class="faq-section__cta">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </footer>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.enable_seo and section.blocks.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        {%- if block.type == 'question' -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | strip_newlines | json }}
            }
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

<script>
  (function () {
    var root = document.getElementById('Faq-{{ section.id }}');
    if (!root) return;
    if (root.dataset.singleOpen !== 'true') return;
    var items = root.querySelectorAll('details.faq-section__item');
    items.forEach(function (d) {
      d.addEventListener('toggle', function () {
        if (!d.open) return;
        items.forEach(function (other) { if (other !== d && other.open) other.open = false; });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "FAQ accordion",
  "tag": "section",
  "class": "section section-faq",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions? We've got answers." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Everything you need to know about ordering, shipping, returns and more." },
    { "type": "checkbox", "id": "single_open", "label": "Only one item open at a time", "default": true },
    { "type": "checkbox", "id": "enable_seo", "label": "Output FAQPage structured data", "default": true, "info": "Adds JSON-LD so search engines can show your FAQ as a rich result." },
    { "type": "header", "content": "Footer" },
    { "type": "textarea", "id": "footer_text", "label": "Footer text", "default": "Still have questions?" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Contact support →" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 56, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 56, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Most orders ship within 1 business day and arrive in 3–5 business days for domestic addresses. Express options are available at checkout.</p>" },
        { "type": "checkbox", "id": "open_by_default", "label": "Open by default", "default": false }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "FAQ accordion",
      "category": "Content",
      "blocks": [
        { "type": "question" },
        { "type": "question", "settings": { "question": "What is your return policy?", "answer": "<p>You can return any unworn item within 30 days for a full refund. Returns are free for orders shipped within the US.</p>" } },
        { "type": "question", "settings": { "question": "Do you ship internationally?", "answer": "<p>Yes — we ship to over 120 countries. Duties and taxes are calculated at checkout.</p>" } },
        { "type": "question", "settings": { "question": "How can I track my order?", "answer": "<p>Once your order ships, you'll receive a confirmation email with a tracking link. You can also log into your account to see real-time status.</p>" } }
      ]
    }
  ]
}
{% endschema %}
