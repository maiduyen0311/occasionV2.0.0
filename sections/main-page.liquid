{%- comment -%}
  Generic page — breadcrumb + title + rich content in a Bootstrap column
  (narrow: col-lg-8, wide: col-12).
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.settings.show_breadcrumb -%}
  {%- assign crumb = page.title | escape -%}
  {% render 'page-breadcrumb', current: crumb %}
{%- endif -%}

{%- liquid
  assign show_body = false
  if section.settings.show_content and page.content != blank
    assign show_body = true
  endif
-%}
{%- if section.settings.show_title or show_body -%}
  <div class="container tm-page tm-page-content section-{{ section.id }}-padding">
    <div class="row justify-content-center">
      <div class="col-12{% if section.settings.width == 'narrow' %} col-lg-10 col-xl-8{% endif %}">
        {%- if section.settings.show_title -%}
          <h1 class="tm-page__title text-{{ section.settings.title_alignment }}">{{ page.title | escape }}</h1>
        {%- endif -%}
        {%- if show_body -%}
          <div class="tm-rich rte">{{ page.content }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_content",
      "label": "Show page content",
      "default": true,
      "info": "Turn off when the template builds the page from sections (About, FAQ…)."
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Title alignment",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Content width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Full container"
        }
      ],
      "default": "narrow"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 60
    }
  ]
}
{% endschema %}
