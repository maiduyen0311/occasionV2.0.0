{% comment %}
  Brand story / About — three layout variants:
    • split-left  : image | text
    • split-right : text  | image
    • overlay     : full-bleed image with overlay text card
{% endcomment %}

{%- assign layout = section.settings.layout | default: 'split-left' -%}

<section
  id="BrandStory-{{ section.id }}"
  class="brand-story brand-story--{{ layout }} section-{{ section.id }} color-{{ section.settings.color_scheme }}"
  style="--brand-story-pt:{{ section.settings.padding_top }}px;--brand-story-pb:{{ section.settings.padding_bottom }}px;{% if section.settings.accent_color != blank %}--brand-story-accent:{{ section.settings.accent_color }};{% endif %}"
>
  {%- if layout == 'overlay' -%}
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="{{ section.settings.image | image_url: width: 800 }} 800w,{{ section.settings.image | image_url: width: 1200 }} 1200w,{{ section.settings.image | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="lazy"
        class="brand-story__bg"
      >
    {%- endif -%}
    <div class="brand-story__overlay-veil" aria-hidden="true"></div>
    <div class="container brand-story__container">
      <div class="brand-story__card">
        {%- if section.settings.eyebrow != blank -%}<p class="brand-story__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="brand-story__heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.body != blank -%}<div class="brand-story__body rte">{{ section.settings.body }}</div>{%- endif -%}
        {%- render 'brand-story-stats', section: section -%}
        {%- render 'brand-story-cta', section: section -%}
      </div>
    </div>
  {%- else -%}
    <div class="container brand-story__container">
      <div class="brand-story__grid">
        <div class="brand-story__media">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1200 }}"
              srcset="{{ section.settings.image | image_url: width: 600 }} 600w,{{ section.settings.image | image_url: width: 900 }} 900w,{{ section.settings.image | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 990px) 50vw, 100vw"
              alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              loading="lazy"
            >
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'brand-story__placeholder' }}
          {%- endif -%}
          {%- if section.settings.image_secondary != blank -%}
            <img
              src="{{ section.settings.image_secondary | image_url: width: 600 }}"
              alt=""
              width="{{ section.settings.image_secondary.width }}"
              height="{{ section.settings.image_secondary.height }}"
              loading="lazy"
              class="brand-story__media-accent"
            >
          {%- endif -%}
        </div>
        <div class="brand-story__copy">
          {%- if section.settings.eyebrow != blank -%}<p class="brand-story__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="brand-story__heading">{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.body != blank -%}<div class="brand-story__body rte">{{ section.settings.body }}</div>{%- endif -%}
          {%- render 'brand-story-stats', section: section -%}
          {%- render 'brand-story-cta', section: section -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Brand story / About",
  "tag": "section",
  "class": "section section-brand-story",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "split-left", "options": [
      { "value": "split-left", "label": "Image left, text right" },
      { "value": "split-right", "label": "Text left, image right" },
      { "value": "overlay", "label": "Full-bleed image with text card" }
    ]},
    { "type": "color", "id": "accent_color", "label": "Accent color", "info": "Leave empty to use the theme accent colour." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "OUR STORY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Crafted for everyday icons" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>From a small studio to thousands of happy customers worldwide — we believe great style should be accessible, sustainable, and made to last. Every piece is designed in-house and produced in small batches.</p>" },
    { "type": "image_picker", "id": "image", "label": "Primary image" },
    { "type": "image_picker", "id": "image_secondary", "label": "Secondary image (split layouts only)" },
    { "type": "header", "content": "Stats (3 max)" },
    { "type": "text", "id": "stat_1_value", "label": "Stat 1 value", "default": "10k+" },
    { "type": "text", "id": "stat_1_label", "label": "Stat 1 label", "default": "Happy customers" },
    { "type": "text", "id": "stat_2_value", "label": "Stat 2 value", "default": "120" },
    { "type": "text", "id": "stat_2_label", "label": "Stat 2 label", "default": "Cities shipped to" },
    { "type": "text", "id": "stat_3_value", "label": "Stat 3 value", "default": "4.9★" },
    { "type": "text", "id": "stat_3_label", "label": "Stat 3 label", "default": "Average rating" },
    { "type": "header", "content": "CTA" },
    { "type": "text", "id": "cta_primary_label", "label": "Primary CTA label", "default": "Discover the collection" },
    { "type": "url", "id": "cta_primary_url", "label": "Primary CTA URL" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary CTA label" },
    { "type": "url", "id": "cta_secondary_url", "label": "Secondary CTA URL" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "default": 64, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "default": 64, "unit": "px" }
  ],
  "presets": [{ "name": "Brand story", "category": "Content" }]
}
{% endschema %}
