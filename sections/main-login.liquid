{%- comment -%}
  Customer login — design/Login.psd: single left-aligned column (Bootstrap
  col-lg-5 ≈ 620px), labels above inputs, dark pill "SIGN IN", "New customer?
  Register" link. The password-recovery form swaps in via `#recover:target`
  (.tm-login in common/scss/section/_account.scss).
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.settings.enable_shop_login_button == false -%}
  {%- assign hide_shop_login_button = true -%}
{%- endif -%}

{%- assign crumb = 'customer.account.title' | t -%}
{% render 'page-breadcrumb', current: crumb %}

<div class="container tm-page tm-auth tm-login section-{{ section.id }}-padding">
  <div class="row">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
      {%- comment -%} Password recovery (hidden until #recover is targeted) {%- endcomment -%}
      <div id="recover" class="tm-login__recover" tabindex="-1">
        <h1 class="tm-auth__title">{{ 'customer.recover_password.title' | t }}</h1>
        <p class="tm-auth__text">{{ 'customer.recover_password.subtext' | t }}</p>

        {%- form 'recover_customer_password' -%}
          {%- assign recover_success = form.posted_successfully? -%}
          {%- if form.errors -%}
            <script>window.location.hash = 'recover';</script>
          {%- endif -%}
          <div class="tm-auth__field">
            <label class="tm-auth__label" for="RecoverEmail">{{ 'customer.login_page.email' | t }}</label>
            <input
              type="email"
              value=""
              name="email"
              id="RecoverEmail"
              class="tm-auth__input"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              required
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="RecoverEmail-email-error"
                autofocus
              {% endif %}
            >
            {%- if form.errors -%}
              <small id="RecoverEmail-email-error" class="tm-field-error">{{ form.errors.messages.form }}</small>
            {%- endif -%}
          </div>
          <div class="tm-auth__actions">
            <button class="tm-auth__submit">{{ 'customer.login_page.submit' | t }}</button>
            <p class="tm-auth__switch"><a href="#login">{{ 'customer.login_page.cancel' | t }}</a></p>
          </div>
        {%- endform -%}
      </div>

      {%- comment -%} Sign in {%- endcomment -%}
      <div id="login" class="tm-login__signin" tabindex="-1">
        <h1 class="tm-auth__title">{{ section.settings.login_heading | default: 'Login' }}</h1>

        {%- if recover_success == true -%}
          <p class="tm-alert tm-alert--success" tabindex="-1" autofocus>{{ 'customer.recover_password.success' | t }}</p>
        {%- endif -%}

        {%- form 'customer_login', novalidate: 'novalidate' -%}
          {%- if form.errors -%}
            <div class="tm-alert tm-alert--error" tabindex="-1" autofocus>
              <span class="visually-hidden">{{ 'accessibility.error' | t }} </span>
              <strong class="tm-alert__title">{{ 'templates.contact.form.error_heading' | t }}</strong>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          {%- if shop.features.login_with_shop_classic_customer_accounts? -%}
            <section name="sign-in-with-shop-provider" class="tm-login__shop">
              {{ shop | login_button: hide_button: hide_shop_login_button }}
              {%- unless hide_shop_login_button -%}
                <p class="tm-divider">{{ 'customer.login_page.alternate_provider_separator' | t }}</p>
              {%- endunless -%}
            </section>
          {%- endif -%}

          <div class="tm-auth__field">
            <label class="tm-auth__label" for="CustomerEmail">{{ 'customer.login_page.email' | t }}</label>
            <input
              type="email"
              name="customer[email]"
              id="CustomerEmail"
              class="tm-auth__input"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              {% if form.errors contains 'form' %}
                aria-invalid="true"
              {% endif %}
            >
          </div>

          {%- if form.password_needed -%}
            <div class="tm-auth__field">
              <label class="tm-auth__label" for="CustomerPassword">{{ 'customer.login_page.password' | t }}</label>
              <input
                type="password"
                value=""
                name="customer[password]"
                id="CustomerPassword"
                class="tm-auth__input"
                autocomplete="current-password"
                {% if form.errors contains 'form' %}
                  aria-invalid="true"
                {% endif %}
              >
            </div>
            <a href="#recover" class="tm-auth__forgot">{{ 'customer.login_page.forgot_password' | t }}</a>
          {%- endif -%}

          <div class="tm-auth__actions">
            <button class="tm-auth__submit">{{ 'customer.login_page.sign_in' | t }}</button>
            <p class="tm-auth__switch">
              {{ section.settings.register_prompt }}
              <a href="{{ routes.account_register_url }}">{{ section.settings.register_link_label }}</a>
            </p>
          </div>
        {%- endform -%}

        {%- if shop.checkout.guest_login -%}
          <div class="tm-auth__guest">
            <h2 class="tm-auth__subtitle">{{ 'customer.login_page.guest_title' | t }}</h2>
            {%- form 'guest_login' -%}
              <button class="tm-auth__submit tm-auth__submit--outline">{{ 'customer.login_page.guest_continue' | t }}</button>
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-login.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_shop_login_button",
      "label": "t:sections.main-login.shop_login_button.enable",
      "default": true
    },
    {
      "type": "text",
      "id": "login_heading",
      "label": "Heading",
      "default": "Login"
    },
    {
      "type": "text",
      "id": "register_prompt",
      "label": "Register prompt",
      "default": "New customer?"
    },
    {
      "type": "text",
      "id": "register_link_label",
      "label": "Register link label",
      "default": "Register"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 100
    }
  ]
}
{% endschema %}
