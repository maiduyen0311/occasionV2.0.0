{% comment %}
  Navigation bar: Shop by categories (mega menu) | main menu | promotion
{% endcomment %}

{% render 'header-bottom', section: section %}

{%- comment -%}
  Mobile drawer — navigation menu + categories settings.
{%- endcomment -%}
{% render 'header-mobile-drawer', section: section %}

{% schema %}
{
  "name": "Navigation",
  "tag": "section",
  "class": "section-navigation",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_desktop_bar",
      "label": "Show desktop bar",
      "default": true,
      "info": "Turn off when Header → Desktop layout is Inline. The mobile menu drawer still uses this section."
    },
    {
      "type": "color",
      "id": "header_bottom_background",
      "label": "Bar background",
      "default": "#33302b"
    },
    {
      "type": "color",
      "id": "header_bottom_categories_background",
      "label": "Categories button & sidebar background",
      "default": "#fb9455"
    },
    {
      "type": "color",
      "id": "header_bottom_text_color",
      "label": "Bar text color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "menu_font_weight",
      "label": "Menu text weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "menu_font_size",
      "label": "Menu text size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "mega_width",
      "label": "Mega menu width",
      "options": [
        {
          "value": "container",
          "label": "Full container"
        },
        {
          "value": "content",
          "label": "Under the menu item, sized to its columns"
        }
      ],
      "default": "container"
    },
    {
      "type": "header",
      "content": "Shop by categories"
    },
    {
      "type": "text",
      "id": "categories_label",
      "label": "Categories button label",
      "default": "All Categories"
    },
    {
      "type": "link_list",
      "id": "categories_menu",
      "label": "Categories menu",
      "info": "Level 1 = sidebar rows. Level 2 = mega column titles. Level 3 = column links. Upload icons per row via Category icon blocks below.",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "open_on_home",
      "label": "Keep the list open on the homepage",
      "default": true,
      "info": "Desktop (1200px and wider): the list sits in the left column of the homepage hero. Turn on Hero → Leave room for the categories list."
    },
    {
      "type": "range",
      "id": "categories_visible",
      "label": "Items shown before See more",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "text",
      "id": "categories_more_label",
      "label": "See more label",
      "default": "See more"
    },
    {
      "type": "text",
      "id": "categories_less_label",
      "label": "See less label",
      "default": "See less"
    },
    {
      "type": "checkbox",
      "id": "show_categories_caret",
      "label": "Show arrow on the button",
      "default": false
    },
    {
      "type": "select",
      "id": "categories_style",
      "label": "List style",
      "options": [
        {
          "value": "icons",
          "label": "Icons"
        },
        {
          "value": "plain",
          "label": "Plain list with dividers"
        },
        {
          "value": "lines",
          "label": "Icons with dividers (Occasion 1.x)"
        }
      ],
      "default": "icons"
    },
    {
      "type": "color",
      "id": "categories_more_color",
      "label": "'See more' menu link colour",
      "info": "A menu item named 'See more'. Empty = accent colour."
    },
    {
      "type": "checkbox",
      "id": "icons_from_files",
      "label": "Use icon files named after menu items",
      "default": false,
      "info": "Upload PNG icons to Content › Files named after each menu item handle, e.g. fashion-clothing.png. Category icon blocks take priority."
    },
    {
      "type": "header",
      "content": "Main navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "textarea",
      "id": "menu_badges",
      "label": "Menu badges",
      "info": "One per line: Menu title|LABEL|#background|#text (text optional), e.g. Shop|NEW|#bbd8b2|#000000"
    },
    {
      "type": "header",
      "content": "Right side"
    },
    {
      "type": "checkbox",
      "id": "show_track_link",
      "label": "Show track order link",
      "default": true
    },
    {
      "type": "text",
      "id": "track_label",
      "label": "Track order label",
      "default": "Track your order"
    },
    {
      "type": "url",
      "id": "track_url",
      "label": "Track order link",
      "info": "Defaults to the customer account page."
    },
    {
      "type": "text",
      "id": "hotline_text",
      "label": "Hotline text",
      "default": "Hotline (+123)4 567 890"
    },
    {
      "type": "text",
      "id": "hotline_phone",
      "label": "Hotline phone number",
      "default": "+1234567890",
      "info": "Used for the tap-to-call link."
    },
    {
      "type": "header",
      "content": "Promotion"
    },
    {
      "type": "checkbox",
      "id": "show_promotion",
      "label": "Show promotion",
      "default": false
    },
    {
      "type": "text",
      "id": "promotion_text",
      "label": "Promotion text",
      "default": "Big promotion now!"
    },
    {
      "type": "url",
      "id": "promotion_url",
      "label": "Promotion URL"
    },
    {
      "type": "header",
      "content": "Mobile menu"
    },
    {
      "type": "text",
      "id": "mobile_menu_label",
      "label": "Menu tab label",
      "default": "Menu"
    },
    {
      "type": "text",
      "id": "mobile_categories_label",
      "label": "Categories tab label",
      "default": "Categories",
      "info": "The Categories tab lists the Categories menu above."
    }
  ],
  "blocks": [
    {
      "type": "megamenu_1",
      "name": "Mega menu style 1",
      "settings": [
        {
          "type": "paragraph",
          "content": "Links + product + side promo. One block per category."
        },
        {
          "type": "text",
          "id": "match_title",
          "label": "Category menu title",
          "info": "Must match level-1 link in Categories menu (e.g. Women's)."
        },
        {
          "type": "range",
          "id": "link_columns",
          "min": 1,
          "max": 4,
          "step": 1,
          "label": "Link columns",
          "default": 3
        },
        {
          "type": "text",
          "id": "column_layout",
          "label": "Headings per column",
          "info": "Optional, e.g. 2,2,2 = 3 columns with 2 heading groups each. Overrides Link columns. Empty = spread evenly."
        },
        {
          "type": "checkbox",
          "id": "show_featured_product",
          "label": "Show featured product column",
          "default": true
        },
        {
          "type": "text",
          "id": "featured_heading",
          "label": "Column heading",
          "default": "Featured Products"
        },
        {
          "type": "product",
          "id": "featured_product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "featured_show_rating",
          "label": "Show star rating",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "featured_show_swatches",
          "label": "Show color swatches",
          "default": true
        },
        {
          "type": "text",
          "id": "featured_button_label",
          "label": "Button label",
          "default": "Select Options"
        },
        {
          "type": "header",
          "content": "Promo banner"
        },
        {
          "type": "checkbox",
          "id": "show_promo_column",
          "label": "Show promo banner column",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "promo_image",
          "label": "Banner image"
        },
        {
          "type": "url",
          "id": "promo_url",
          "label": "Banner link"
        },
        {
          "type": "paragraph",
          "content": "Text overlay is optional — leave empty when the banner image already contains text."
        },
        {
          "type": "text",
          "id": "promo_heading",
          "label": "Heading",
          "info": "E.g. don't miss the deal"
        },
        {
          "type": "text",
          "id": "promo_text",
          "label": "Text",
          "info": "E.g. New styles are on sale"
        },
        {
          "type": "text",
          "id": "promo_button_label",
          "label": "Button label",
          "info": "E.g. SHOP NOW"
        },
        {
          "type": "color",
          "id": "promo_heading_color",
          "label": "Heading color",
          "default": "#561e03"
        },
        {
          "type": "color",
          "id": "promo_text_color",
          "label": "Text color",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "promo_button_bg",
          "label": "Button background",
          "default": "#f05d17"
        },
        {
          "type": "color",
          "id": "promo_button_text_color",
          "label": "Button text color",
          "default": "#ffffff"
        }
      ]
    },
    {
      "type": "megamenu_2",
      "name": "Mega menu style 2",
      "settings": [
        {
          "type": "paragraph",
          "content": "Link columns + 3 bordered cards (title + cut-out image popping above the card)."
        },
        {
          "type": "text",
          "id": "match_title",
          "label": "Category menu title"
        },
        {
          "type": "range",
          "id": "link_columns",
          "min": 3,
          "max": 6,
          "step": 1,
          "label": "Link columns",
          "default": 5
        },
        {
          "type": "text",
          "id": "column_layout",
          "label": "Headings per column",
          "info": "Optional, e.g. 1,2,1,1,1 = 5 columns, the 2nd holds 2 heading groups. Overrides Link columns. Empty = spread evenly."
        },
        {
          "type": "paragraph",
          "content": "Card images: portrait cut-out on white background works best (about 50 × 115 px, uploaded at 2×)."
        },
        {
          "type": "header",
          "content": "Card 1"
        },
        {
          "type": "text",
          "id": "card_1_title",
          "label": "Title",
          "default": "Summer Sale"
        },
        {
          "type": "image_picker",
          "id": "card_1_image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "card_1_url",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Card 2"
        },
        {
          "type": "text",
          "id": "card_2_title",
          "label": "Title",
          "default": "Beach Style"
        },
        {
          "type": "image_picker",
          "id": "card_2_image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "card_2_url",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Card 3"
        },
        {
          "type": "text",
          "id": "card_3_title",
          "label": "Title",
          "default": "Sleep & Lounge"
        },
        {
          "type": "image_picker",
          "id": "card_3_image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "card_3_url",
          "label": "Link"
        }
      ]
    },
    {
      "type": "megamenu_3",
      "name": "Mega menu style 3",
      "settings": [
        {
          "type": "paragraph",
          "content": "Link columns + vertical side banner (image + link)."
        },
        {
          "type": "text",
          "id": "match_title",
          "label": "Category menu title"
        },
        {
          "type": "range",
          "id": "link_columns",
          "min": 2,
          "max": 5,
          "step": 1,
          "label": "Link columns",
          "default": 4
        },
        {
          "type": "text",
          "id": "column_layout",
          "label": "Headings per column",
          "info": "Optional, e.g. 1,1,1,1. Overrides Link columns. Empty = spread evenly."
        },
        {
          "type": "checkbox",
          "id": "heading_icons",
          "label": "Icon above each heading",
          "default": false,
          "info": "Uses PNG icons from Content › Files named after each heading handle, e.g. man.png."
        },
        {
          "type": "header",
          "content": "Side banner"
        },
        {
          "type": "paragraph",
          "content": "Recommended size 454 × 650 px (portrait)."
        },
        {
          "type": "image_picker",
          "id": "banner_image",
          "label": "Banner image"
        },
        {
          "type": "url",
          "id": "banner_url",
          "label": "Banner link"
        }
      ]
    },
    {
      "type": "megamenu_4",
      "name": "Mega menu style 4",
      "settings": [
        {
          "type": "paragraph",
          "content": "Link columns spread full width + 2 wide bottom banners."
        },
        {
          "type": "text",
          "id": "match_title",
          "label": "Category menu title"
        },
        {
          "type": "range",
          "id": "link_columns",
          "min": 2,
          "max": 5,
          "step": 1,
          "label": "Link columns",
          "default": 4
        },
        {
          "type": "text",
          "id": "column_layout",
          "label": "Headings per column",
          "info": "Optional, e.g. 1,1,1,1. Overrides Link columns. Empty = spread evenly."
        },
        {
          "type": "paragraph",
          "content": "Bottom banners: recommended size 1094 × 336 px each."
        },
        {
          "type": "header",
          "content": "Bottom banner 1"
        },
        {
          "type": "image_picker",
          "id": "banner_1_image",
          "label": "Banner image"
        },
        {
          "type": "url",
          "id": "banner_1_url",
          "label": "Banner link"
        },
        {
          "type": "header",
          "content": "Bottom banner 2"
        },
        {
          "type": "image_picker",
          "id": "banner_2_image",
          "label": "Banner image"
        },
        {
          "type": "url",
          "id": "banner_2_url",
          "label": "Banner link"
        }
      ]
    },
    {
      "type": "megamenu_compact",
      "name": "Mega menu compact",
      "settings": [
        {
          "type": "paragraph",
          "content": "Headings and links only, in a narrow panel (Occasion \"Electronics\" = 3 columns, \"Digital & Electric\" = 2 columns)."
        },
        {
          "type": "text",
          "id": "match_title",
          "label": "Category menu title"
        },
        {
          "type": "range",
          "id": "link_columns",
          "min": 1,
          "max": 4,
          "step": 1,
          "label": "Columns",
          "default": 3
        },
        {
          "type": "range",
          "id": "panel_width",
          "min": 250,
          "max": 1000,
          "step": 10,
          "unit": "px",
          "label": "Panel width",
          "default": 600
        }
      ]
    },
    {
      "type": "category_icon",
      "name": "Category icon",
      "settings": [
        {
          "type": "text",
          "id": "match_title",
          "label": "Menu link title",
          "info": "Must match the level-1 link title in Categories menu exactly."
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Navigation",
      "blocks": [
        {
          "type": "megamenu_1",
          "settings": {
            "match_title": "Women's",
            "link_columns": 3,
            "featured_heading": "Featured Products"
          }
        },
        {
          "type": "megamenu_2",
          "settings": {
            "match_title": "Men's",
            "link_columns": 5,
            "column_layout": "1,2,1,1,1"
          }
        },
        {
          "type": "megamenu_3",
          "settings": {
            "match_title": "Clothing",
            "link_columns": 4
          }
        },
        {
          "type": "megamenu_4",
          "settings": {
            "match_title": "Shoes",
            "link_columns": 4
          }
        },
        {
          "type": "category_icon",
          "settings": {
            "match_title": "Women's"
          }
        },
        {
          "type": "category_icon",
          "settings": {
            "match_title": "Men's"
          }
        },
        {
          "type": "category_icon",
          "settings": {
            "match_title": "Clothing"
          }
        },
        {
          "type": "category_icon",
          "settings": {
            "match_title": "Shoes"
          }
        },
        {
          "type": "category_icon",
          "settings": {
            "match_title": "Accessories"
          }
        },
        {
          "type": "category_icon",
          "settings": {
            "match_title": "Bags"
          }
        },
        {
          "type": "category_icon",
          "settings": {
            "match_title": "Watches"
          }
        },
        {
          "type": "category_icon",
          "settings": {
            "match_title": "Jewellery"
          }
        },
        {
          "type": "category_icon",
          "settings": {
            "match_title": "Seasonal Wear"
          }
        }
      ]
    }
  ]
}
{% endschema %}
