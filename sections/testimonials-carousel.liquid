{% comment %}
  Testimonials carousel — CSS scroll-snap (no JS dependency).
  Each block is a card with quote, author, role, avatar and rating.
{% endcomment %}

<section
  id="Testimonials-{{ section.id }}"
  class="testimonials{% if section.settings.side_image != blank %} testimonials--split testimonials--image-{{ section.settings.image_position | default: 'left' }}{% endif %} section-{{ section.id }} color-{{ section.settings.color_scheme }}"
  style="--testimonials-pt:{{ section.settings.padding_top }}px;--testimonials-pb:{{ section.settings.padding_bottom }}px;--testimonials-bg:{{ section.settings.background_color }};"
  data-testimonials-root
>
  {%- if section.settings.side_image != blank -%}
    {%- comment -%} Split layout: photo on one half, one testimonial at a time on the other {%- endcomment -%}
    <div class="testimonials__side-media">
      {{
        section.settings.side_image
        | image_url: width: 1400
        | image_tag:
          class: 'testimonials__side-image',
          loading: 'lazy',
          widths: '600, 900, 1200, 1400',
          sizes: '(min-width: 992px) 50vw, 100vw',
          alt: section.settings.side_image.alt | default: ''
      }}
    </div>
  {%- endif -%}
  <div class="container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
      <header class="testimonials__header">
        {%- if section.settings.eyebrow != blank -%}<p class="testimonials__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="testimonials__heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="testimonials__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
      </header>
    {%- endif -%}

    <div class="testimonials__viewport" data-testimonials-viewport>
      <button type="button" class="testimonials__arrow testimonials__arrow--prev" data-testimonials-prev aria-label="{{ 'general.slider.previous_slide' | t }}">‹</button>

      <div class="testimonials__track" data-testimonials-track>
        {%- for block in section.blocks -%}
          {%- if block.type == 'testimonial' -%}
            {%- assign rating = block.settings.rating | default: 5 -%}
            <article class="testimonials__card" {{ block.shopify_attributes }}>
              {%- if section.settings.show_rating -%}
                <div class="testimonials__rating" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating, rating_max: 5 }}">
                  {%- for i in (1..5) -%}
                    <span class="testimonials__star {% if i <= rating %}is-filled{% endif %}" aria-hidden="true">★</span>
                  {%- endfor -%}
                </div>
              {%- endif -%}
              {%- if block.settings.quote != blank -%}
                <blockquote class="testimonials__quote">{{ block.settings.quote }}</blockquote>
              {%- endif -%}
              <footer class="testimonials__author-row">
                {%- if block.settings.avatar != blank -%}
                  <img class="testimonials__avatar" src="{{ block.settings.avatar | image_url: width: 96 }}" alt="" loading="lazy" width="48" height="48">
                {%- else -%}
                  <span class="testimonials__avatar testimonials__avatar--placeholder" aria-hidden="true">{{ block.settings.author | slice: 0, 1 }}</span>
                {%- endif -%}
                <div class="testimonials__author">
                  {%- assign t_author = block.settings.author -%}
                  {%- if t_author == blank -%}{%- assign t_author = 'sections.product_reviews.anonymous' | t -%}{%- endif -%}
                  <strong>{{ t_author }}</strong>
                  {%- if block.settings.role != blank -%}<span>{{ block.settings.role }}</span>{%- endif -%}
                </div>
                {%- if block.settings.show_verified -%}
                  <span class="testimonials__verified" title="{{ 'sections.product_reviews.verified_buyer' | t }}">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    {{ 'sections.product_reviews.verified' | t }}
                  </span>
                {%- endif -%}
              </footer>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <button type="button" class="testimonials__arrow testimonials__arrow--next" data-testimonials-next aria-label="{{ 'general.slider.next_slide' | t }}">›</button>
    </div>

    {%- if section.settings.show_dots -%}
      <div class="testimonials__dots" data-testimonials-dots role="tablist" aria-label="{{ 'general.slider.name' | t }}"></div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('Testimonials-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('[data-testimonials-track]');
    if (!track) return;
    var prevBtn = root.querySelector('[data-testimonials-prev]');
    var nextBtn = root.querySelector('[data-testimonials-next]');
    var dotsEl = root.querySelector('[data-testimonials-dots]');
    var cards = track.querySelectorAll('.testimonials__card');
    if (!cards.length) return;

    function scrollByOne(dir) {
      var card = track.querySelector('.testimonials__card');
      if (!card) return;
      var w = card.getBoundingClientRect().width + parseFloat(getComputedStyle(track).gap || 0);
      track.scrollBy({ left: dir * w, behavior: 'smooth' });
    }
    if (prevBtn) prevBtn.addEventListener('click', function () { scrollByOne(-1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { scrollByOne(1); });

    if (dotsEl) {
      cards.forEach(function (_, i) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'testimonials__dot';
        b.setAttribute('aria-label', 'Go to testimonial ' + (i + 1));
        b.addEventListener('click', function () {
          var card = cards[i];
          if (card) card.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
        });
        dotsEl.appendChild(b);
      });
      var dots = dotsEl.querySelectorAll('.testimonials__dot');
      track.addEventListener('scroll', function () {
        var scrollL = track.scrollLeft;
        var widths = Array.from(cards).map(function (c) { return c.offsetLeft; });
        var active = 0;
        for (var i = 0; i < widths.length; i++) {
          if (scrollL + 8 >= widths[i]) active = i;
        }
        dots.forEach(function (d, i) { d.classList.toggle('is-active', i === active); });
      });
      if (dots[0]) dots[0].classList.add('is-active');
    }

    if ({{ section.settings.autoplay | json }}) {
      var interval = {{ section.settings.autoplay_speed | default: 5 }} * 1000;
      var timer = setInterval(function () {
        if (document.hidden) return;
        var atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 8;
        if (atEnd) {
          track.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          scrollByOne(1);
        }
      }, interval);
      root.addEventListener('mouseenter', function () { clearInterval(timer); });
    }
  })();
</script>

{% schema %}
{
  "name": "Testimonials carousel",
  "tag": "section",
  "class": "section section-testimonials",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fff7ee"
    },
    {
      "type": "image_picker",
      "id": "side_image",
      "label": "Side image",
      "info": "Adds a photo on one half of the section and shows one testimonial at a time on the other."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Side image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "REVIEWS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers say"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real reviews from real shoppers."
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show pagination dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay interval (seconds)",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Absolutely love it — fits perfectly and the fabric is even better than the photos suggest. Will be back for more!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Sarah J."
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / location",
          "default": "Verified buyer • Hanoi"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "show_verified",
          "label": "Show verified-buyer badge",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Testimonials carousel",
      "category": "Reviews",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial",
          "settings": {
            "author": "James K.",
            "role": "Verified buyer • Singapore",
            "quote": "Customer service was outstanding when I needed to exchange a size. Will definitely shop here again."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "author": "Linh P.",
            "role": "Verified buyer • Saigon",
            "quote": "The quality is way better than I expected for the price. Shipping was fast too."
          }
        }
      ]
    }
  ]
}
{% endschema %}
