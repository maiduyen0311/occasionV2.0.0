{%- comment -%}
  Password / "coming soon" page — Bootstrap row: text + newsletter form
  (col-lg-6) beside an image (col-lg-6). Styles: _password.scss.

  The store password itself is not available to Liquid; the merchant writes it in
  Online Store › Preferences › Password protection › "Message for your visitors"
  (e.g. "Top Market password: 10"), exposed as shop.password_message.
{%- endcomment -%}

{%- liquid
  assign password_message = shop.password_message | strip_html | strip
  assign message_as_heading = false
  if section.settings.password_message_as_heading and password_message != blank
    assign message_as_heading = true
  endif
-%}

{%- style -%}
  #tm-password-{{ section.id }} {
    --tm-pw-bg: {{ section.settings.background }};
    --tm-pw-text: {{ section.settings.text_color }};
  }
{%- endstyle -%}

<section id="tm-password-{{ section.id }}" class="tm-password">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-12 col-lg-6">
        {%- if section.settings.eyebrow != blank -%}
          <p class="tm-password__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if message_as_heading -%}
          <h1 class="tm-password__title">{{ password_message | escape }}</h1>
        {%- else -%}
          <h1 class="tm-password__title">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}
        {%- if password_message != blank and message_as_heading == false -%}
          <div class="tm-password__text">{{ password_message | escape | newline_to_br }}</div>
        {%- elsif section.settings.text != blank -%}
          <div class="tm-password__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.show_newsletter -%}
          {%- form 'customer', id: 'PasswordNewsletter', class: 'tm-password__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter,prospect">
            {%- if form.posted_successfully? -%}
              <p class="tm-alert tm-alert--success" tabindex="-1" autofocus>{{ 'newsletter.success' | t }}</p>
            {%- else -%}
              {%- if form.errors -%}
                <p class="tm-alert tm-alert--error" id="PasswordNewsletter-error">
                  {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                </p>
              {%- endif -%}
              <div class="tm-search__form">
                <label class="visually-hidden" for="PasswordNewsletter-email">{{ 'newsletter.label' | t }}</label>
                <input
                  id="PasswordNewsletter-email"
                  type="email"
                  name="contact[email]"
                  class="tm-input"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  required
                  placeholder="{{ 'newsletter.label' | t }}"
                  {% if form.errors %}aria-invalid="true" aria-describedby="PasswordNewsletter-error"{% endif %}
                >
                <button type="submit" class="tm-btn" name="commit">{{ section.settings.button_label | escape }}</button>
              </div>
            {%- endif -%}
          {%- endform -%}
          {%- if section.settings.note != blank -%}
            <p class="tm-password__note">{{ section.settings.note | escape }}</p>
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="col-12 col-lg-6">
        <div class="tm-password__media">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 992px) 50vw, 100vw', alt: section.settings.image.alt }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Coming soon"
    },
    {
      "type": "checkbox",
      "id": "password_message_as_heading",
      "label": "Show password message as heading",
      "info": "Uses the message from Online Store › Preferences › Password protection (e.g. \"Top Market password: 10\"). The heading below is shown when the message is empty.",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We're launching something new"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Our new collection is almost ready. Sign up to be the first to know when we open — and get 10% off your first order.</p>",
      "info": "Replaced by the password message from Online Store › Preferences when it is not used as the heading."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter form",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note below the form",
      "default": "No spam. Unsubscribe any time."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#fdf3ee"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    }
  ]
}
{% endschema %}
