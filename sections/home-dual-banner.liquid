{%- style -%}
  #DualBanner-{{ section.id }} {
    --section-pt: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --section-pb: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    --gap: {{ section.settings.gap }}px;
    --radius: {{ section.settings.border_radius }}px;
  }

  @media screen and (min-width: 750px) {
    #DualBanner-{{ section.id }} {
      --section-pt: {{ section.settings.padding_top }}px;
      --section-pb: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="DualBanner-{{ section.id }}"
  class="home-dual-banner home-dual-banner--fit-{{ section.settings.image_fit | default: 'contain' }} section-{{ section.id }} section-home-dual-banner color-{{ section.settings.color_scheme }} gradient"
  data-section-id="{{ section.id }}"
>
  <div class="{% if section.settings.full_width %}container-fluid{% else %}container{% endif %}">
    {%- if section.blocks.size > 0 -%}
      <div class="home-dual-banner__grid d-grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign tile_tag = 'div'
            if block.settings.link != blank
              assign tile_tag = 'a'
            endif

            assign eyebrow_script = block.settings.eyebrow_script
            assign title_bold = block.settings.title_bold
            assign image_position = block.settings.image_position | default: 'right'
            assign image_only = false
            if block.settings.image_only and block.settings.image != blank
              assign image_only = true
            endif
          -%}
          <{{ tile_tag }}
            class="home-dual-banner__tile d-flex h-100 home-dual-banner__tile--image-{{ image_position }}{% if image_only %} tm-image-banner{% endif %}"
            style="--tile-bg: {{ block.settings.background_color }};{% if image_only %} --tm-ratio: {{ block.settings.image.aspect_ratio }};{% endif %}"
            {% if block.settings.link != blank %}
              href="{{ block.settings.link }}"
              aria-label="{{ title_bold | escape }}"
            {% endif %}
            {{ block.shopify_attributes }}
          >
{%- if image_only -%}
  <div class="tm-image-banner__media">
    {{
      block.settings.image
      | image_url: width: 1600
      | image_tag:
        loading: 'lazy',
        widths: '400, 700, 1000, 1400, 1600',
        sizes: '(min-width: 992px) 690px, 100vw',
        alt: block.settings.image.alt | default: ''
    }}
  </div>
{%- endif -%}
            <div class="home-dual-banner__content d-flex flex-column">
              {%- if eyebrow_script != blank -%}
                <span class="home-dual-banner__eyebrow">{{ eyebrow_script }}</span>
              {%- endif -%}
              {%- if title_bold != blank -%}
                <h3 class="home-dual-banner__title">{{ title_bold }}</h3>
              {%- endif -%}
            </div>

            <div class="home-dual-banner__media w-100" aria-hidden="true">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    class: 'home-dual-banner__image',
                    loading: 'lazy',
                    widths: '240, 320, 480, 640, 800',
                    sizes: '(min-width: 768px) 320px, 50vw',
                    alt: block.settings.image.alt | default: title_bold
                }}
              {%- else -%}
                {{ 'hero-apparel-2' | placeholder_svg_tag: 'home-dual-banner__image home-dual-banner__image--placeholder' }}
              {%- endif -%}
            </div>
          </{{ tile_tag }}>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Home dual banner",
  "tag": "section",
  "class": "section-home-dual-banner",
  "max_blocks": 2,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Gap between banners",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Corner radius",
      "default": 12
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Side image fit",
      "options": [
        { "value": "contain", "label": "Contain (cut-out images)" },
        { "value": "cover", "label": "Cover (photos fill half the banner)" }
      ],
      "default": "contain",
      "info": "Only for banners where \"Image already contains text\" is off."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "color",
          "id": "background_color",
          "label": "Background color",
          "default": "#f3d2c9"
        },
        {
          "type": "text",
          "id": "eyebrow_script",
          "label": "Eyebrow script text",
          "default": "Spring Collection Day"
        },
        {
          "type": "text",
          "id": "title_bold",
          "label": "Bold title",
          "default": "SALE 30%"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Banner image",
          "info": "Model or product photo placed on the chosen side."
        },
        {
          "type": "checkbox",
          "id": "image_only",
          "label": "Image already contains text",
          "info": "Show only the image, full size (e.g. banner artwork with text baked in). Text settings are ignored.",
          "default": false
        },
        {
          "type": "url",
          "id": "link",
          "label": "Banner link"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "right"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home dual banner",
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "background_color": "#f3d2c9",
            "eyebrow_script": "Spring Collection Day",
            "title_bold": "SALE 30%",
            "image_position": "right"
          }
        },
        {
          "type": "banner",
          "settings": {
            "background_color": "#cdd8d4",
            "eyebrow_script": "Trend 2021",
            "title_bold": "Women's",
            "image_position": "right"
          }
        }
      ]
    }
  ]
}
{% endschema %}
