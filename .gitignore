.shopify
node_modules
.DS_Store

# Design source files (heavy — keep locally, share via cloud)
design/*.psd
design/*.psb
design/*.ai
design/*.sketch
design/*.fig

# PSD-extracted raw asset dump (regenerate via scripts/extract-psd-images.py)
common/img/psd-extracted/

# Claude Code per-user local settings
.claude/settings.local.json

# Local environment variables (Shopify store URL, theme IDs, secrets)
.env
.env.local
.env.*.local

# Compiled SCSS output — regenerate via `npm run build:css` (or `npm run dev`
# watch mode). Tracking it produces noisy diffs on every save.
assets/styles.css
assets/styles.css.map
assets/component-localization-form.css
assets/component-localization-form.css.map
assets/*.css.map

# Compiled webpack output — regenerate via `npm run webpack` (one-shot) or
# `npm run dev` (watch). Source lives in common/js/.
assets/common.js
assets/common.js.map

# Concatenated Dawn component CSS bundle. Auto-generated by
# scripts/bundle-dawn-css.js. Regenerate via `npm run build:dawn`
# (also runs as prestep of `npm run build` and `npm run dev`).
assets/dawn-bundle.css

# Release builds (npm run release / npm run package)
dist/
*.zip
