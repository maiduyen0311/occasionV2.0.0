<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    {%- render 'oc-default-locale' -%}
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {%- comment -%}
      Occasion — fonts from PSD (Jost, Yellowtail, Caveat, Playfair
      Display) are now served via Shopify's font CDN through font_picker
      settings. Per-weight @font-face declarations are emitted in
      snippets/theme-styles.liquid via the font_face filter.
    {%- endcomment -%}


    {%- liquid
      # Theme settings → Logo → "Store name on the storefront" can replace the store name
      assign store_name = settings.store_display_name | default: shop.name
      assign title_text = page_title
      if title_text == shop.name
        assign title_text = store_name
      endif
    -%}
    <title>
      {{ title_text }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless title_text contains store_name %} &ndash; {{ store_name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {%- comment -%} Dawn Web Components (constants, pubsub, global) — theme features live in common.js {%- endcomment -%}
    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    {%- if settings.animations_reveal_on_scroll -%}
      <script src="{{ 'animations.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {{ content_for_header }}

    {%- comment -%}
      Single blocking stylesheet compiled from common/scss/styles.scss
      (Bootstrap grid/utilities + Occasion styles).
    {%- endcomment -%}
    {{ 'styles.css' | asset_url | stylesheet_tag }}

    {%- comment -%}
      `theme-styles` renders AFTER styles.css so the runtime font_picker /
      color_scheme settings beat the compile-time SCSS fallbacks declared
      at :root in styles.css. Same specificity → later source wins.
    {%- endcomment -%}
    {%- render 'theme-styles' -%}

    {%- unless settings.font_body.system? -%}
      {% comment %}theme-check-disable AssetPreload{% endcomment %}
      <link rel="preload" as="font" href="{{ settings.font_body | font_url }}" type="font/woff2" crossorigin>
      {% comment %}theme-check-enable AssetPreload{% endcomment %}
    {%- endunless -%}
    {%- unless settings.font_heading.system? -%}
      {% comment %}theme-check-disable AssetPreload{% endcomment %}
      <link rel="preload" as="font" href="{{ settings.font_heading | font_url }}" type="font/woff2" crossorigin>
      {% comment %}theme-check-enable AssetPreload{% endcomment %}
    {%- endunless -%}

    {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
      {{ 'component-localization-form.css' | asset_url | stylesheet_tag: preload: true }}
      <script src="{{ 'localization-form.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if settings.predictive_search_enabled -%}
      <link
        rel="stylesheet"
        href="{{ 'component-predictive-search.css' | asset_url }}"
        media="print"
        onload="this.media='all'"
      >
    {%- endif -%}

    <script>
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
  </head>

  <body class="gradient template-{{ template.name }}{% if settings.card_badge_shape == 'tag' %} tm-badge-tag{% endif %}{% if settings.card_hover_actions == 'bar' %} tm-hover-bar{% endif %}{% if settings.corner_style == 'square' %} tm-corners-square{% endif %}{% if settings.animations_hover_elements != 'none' %} animate--hover-{{ settings.animations_hover_elements }}{% endif %}">
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {%- comment -%}
      Mini cart dropdown (design/dropcart.jpg) — Dawn's <cart-drawer> restyled
      as a dropdown under the header cart icon. Not rendered on /cart itself.
    {%- endcomment -%}
    {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
      {%- render 'cart-drawer' -%}
    {%- endif -%}

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {%- if settings.trust_strip_enabled and template != 'cart' -%}
      <div class="trust-strip-wrapper container" style="max-width:1200px;margin:32px auto;padding:0 16px;">
        {% render 'trust-strip', variant: 'full' %}
      </div>
    {%- endif -%}

    {% sections 'footer-group' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    {%- render 'quick-view-modal' -%}
    {%- render 'cookie-banner' -%}
    {%- render 'social-proof-popup' -%}

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}',
      };

      // `t` output is HTML-escaped (Women&#39;s): decode once for textContent / toasts
      window.tmDecode = (s) => { const el = document.createElement('textarea'); el.innerHTML = s; return el.value; };
      window.tmStrings = {
        addedToCart: tmDecode({{ 'sections.mini_cart.added' | t | json }}),
        compareAdded: tmDecode({{ 'sections.mini_cart.compare_added' | t | json }}),
        compareRemoved: tmDecode({{ 'sections.mini_cart.compare_removed' | t | json }}),
        onSale: tmDecode({{ 'products.product.on_sale' | t | json }}),
      };

      // Confirmation popups (common/js/modules/oc-notify.js) — PSD "Button add"
      window.ocSettings = {
        cartFeedback: {{ settings.cart_feedback | default: 'popup' | json }},
        wishlistPopup: {{ settings.wishlist_popup | json }},
        wishlistUrl: {{ pages['wish-list'].url | default: '/pages/wishlist' | json }},
        strings: {
          close: tmDecode({{ 'accessibility.close' | t | json }}),
          continueShopping: tmDecode({{ 'sections.oc_notify.continue_shopping' | t | json }}),
          addedToCart: tmDecode({{ 'sections.oc_notify.added_to_cart' | t | json }}),
          goToCart: tmDecode({{ 'sections.oc_notify.go_to_cart' | t | json }}),
          addedToWishlist: tmDecode({{ 'sections.oc_notify.added_to_wishlist' | t | json }}),
          goToWishlist: tmDecode({{ 'sections.oc_notify.go_to_wishlist' | t | json }}),
        },
      };

      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`,
      };

      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
        unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' }}`,
      };

      window.quickOrderListStrings = {
        itemsAdded: `{{ 'sections.quick_order_list.items_added.other' | t: quantity: '[quantity]' }}`,
        itemAdded: `{{ 'sections.quick_order_list.items_added.one' | t: quantity: '[quantity]' }}`,
        itemsRemoved: `{{ 'sections.quick_order_list.items_removed.other' | t: quantity: '[quantity]' }}`,
        itemRemoved: `{{ 'sections.quick_order_list.items_removed.one' | t: quantity: '[quantity]' }}`,
        viewCart: `{{- 'sections.quick_order_list.view_cart' | t -}}`,
        each: `{{- 'sections.quick_order_list.each' | t: money: '[money]' }}`,
        min_error: `{{- 'sections.quick_order_list.min_error' | t: min: '[min]' }}`,
        max_error: `{{- 'sections.quick_order_list.max_error' | t: max: '[max]' }}`,
        step_error: `{{- 'sections.quick_order_list.step_error' | t: step: '[step]' }}`,
      };

      window.accessibilityStrings = {
        imageAvailable: `{{ 'products.product.media.image_available' | t: index: '[index]' }}`,
        shareSuccess: `{{ 'general.share.success_message' | t }}`,
        pauseSlideshow: `{{ 'sections.slideshow.pause_slideshow' | t }}`,
        playSlideshow: `{{ 'sections.slideshow.play_slideshow' | t }}`,
        recipientFormExpanded: `{{ 'recipient.form.expanded' | t }}`,
        recipientFormCollapsed: `{{ 'recipient.form.collapsed' | t }}`,
        countrySelectorSearchCount: `{{ 'localization.country_results_count' | t: count: '[count]' }}`,
      };
    </script>

    {%- if settings.predictive_search_enabled -%}
      {%- comment -%}
        `predictive-search.js` defines a custom element that `extends SearchForm`.
        `search-form.js` must load first so the parent class is defined before the
        subclass runs. Both use defer, so order in source = order of execution.
      {%- endcomment -%}
      <script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    
    <script src="{{ 'common.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
